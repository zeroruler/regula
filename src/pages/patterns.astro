---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PatternSubnav from '../components/PatternSubnav.astro';
import { patternsByGroup } from '../lib/patterns';
import { href } from '../lib/url';

// 목록은 입구만 둔다. 카드·눈금·비교표와 실습은 카테고리 페이지에서 본다.
const groups = await patternsByGroup();
---
<Base title="UI 패턴 · Regula" current="patterns">
  <Fragment slot="sub"><PatternSubnav /></Fragment>

  <PageHead current="patterns" title="언제 쓰고, 언제 피하나">
    <p>컴포넌트가 어떻게 생겼는지보다 언제 쓰고 언제 피하는지를 모읍니다. 카테고리마다 페이지가 있고, 그 안에서 한 가지 기준(방해 정도, 시각적 무게…)으로 줄을 세웠어요. 미니 목업은 흑백 와이어프레임입니다.</p>
  </PageHead>

  <section class="doors">
    <h2 class="label">카테고리</h2>
    {groups.map(({ group: g, items }, i) => (
      <a class="door" href={href(g.path)}>
        <span class="no">{String(i + 1).padStart(2, '0')}</span>
        <span class="t"><b>{g.name}</b><small>{g.title}{g.levelName && ` · ${g.levelName} 순`}</small></span>
        <span class="n">{g.level ? `${items.length}가지` : '실습'} →</span>
      </a>
    ))}
  </section>
</Base>
