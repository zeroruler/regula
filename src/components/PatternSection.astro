---
// 한 카테고리의 패턴 목록: 눈금 → 카드 → 비교표. 카테고리 페이지마다 같은 모양으로 쓴다.
import type { CollectionEntry } from 'astro:content';
import PatternCard from './PatternCard.astro';
import IntrusivenessScale from './IntrusivenessScale.astro';
import type { patternGroups } from '../lib/site';

type Field = 'dismiss' | 'actions' | 'per_view' | 'fits';
interface Props {
  group: (typeof patternGroups)[number];
  items: CollectionEntry<'patterns'>[];
  // 비교표에서 이름과 "헷갈리는 짝" 사이에 넣을 열
  cols: { h: string; k: Field }[];
  label?: string;
}
const { group: g, items, cols, label = '종류' } = Astro.props;
---
<section id={g.id}>
  <header>
    <span class="label">{label}</span>
    <h2>{g.title} {items.length}가지</h2>
    <p>{g.intro}</p>
  </header>
  <IntrusivenessScale names={items.map((p) => p.data.name)} ends={g.ends} />
  <div class="patterns">
    {items.map((p) => <PatternCard pattern={p} />)}
  </div>
  <div class="compare">
    <table>
      <thead><tr><th>{g.name}</th>{cols.map((c) => <th>{c.h}</th>)}<th>헷갈리는 짝과의 차이</th><th>출처</th></tr></thead>
      <tbody>
        {items.map(({ data: p }) => (
          <tr><td>{p.name}</td>{cols.map((c) => <td>{p[c.k]}</td>)}<td>{p.confused_with}</td><td class="src-cell">{p.source}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
