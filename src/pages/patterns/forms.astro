---
import Base from '../../layouts/Base.astro';
import PatternSection from '../../components/PatternSection.astro';
import PatternSubnav from '../../components/PatternSubnav.astro';
import Labels from '../../demos/forms/Labels.astro';
import Validation from '../../demos/forms/Validation.astro';
import { patternsByGroup } from '../../lib/patterns';
import { href } from '../../lib/url';
import Cite from '../../components/Cite.astro';
import { rulesOf, ruleId } from '../../lib/rules';

const groups = await patternsByGroup();
const { group, items: inputs } = groups.find((x) => x.group.id === 'forms')!;

const { rules } = rulesOf('forms');
---
<Base title="입력 · UI 패턴 · Regula" current="patterns" description="라벨 위치와 검증 시점을 바꿔 가며 직접 써 보는 폼 실습 페이지">
  <Fragment slot="sub"><PatternSubnav current={['forms']} /></Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('patterns/')}>§ 3 UI 패턴</a> · 실습</span>
    <h1>묻는 말은 끝까지 보이게</h1>
    <p>폼은 대화입니다. 무엇을 묻는지 계속 보여 주고(라벨), 답이 틀렸으면 알맞은 때에 어떻게 고칠지 말해 줘야(검증) 합니다. 아래 폼은 진짜 입력칸이에요. 직접 써 보세요.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 라벨 위치</span>
      <h2>위, 왼쪽, 안쪽</h2>
      <p>라벨을 어디에 두느냐에 따라 눈이 움직이는 길과, 쓰는 동안 질문이 남아 있는지가 갈립니다.</p>
    </header>
    <Labels />
  </section>

  <section>
    <header>
      <span class="label">2 · 검증 시점</span>
      <h2>너무 이르지도, 너무 늦지도 않게</h2>
      <p>같은 이메일 칸을 세 시점으로 바꿔 써 보세요. 일부러 틀리게 쓰다가 고쳐 보면 차이가 보입니다.</p>
    </header>
    <Validation />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r, i) => <tr id={ruleId('forms', i)}><td>{r.s}</td><td>{r.rule}</td><td class="src-cell"><Cite text={r.src} /></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <PatternSection group={group} items={inputs} cols={[{h: '알맞은 답', k: 'fits'}]} />
</Base>
