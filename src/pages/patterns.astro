---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PatternCard from '../components/PatternCard.astro';
import IntrusivenessScale from '../components/IntrusivenessScale.astro';
import { patternsByGroup } from '../lib/patterns';
import { href } from '../lib/url';

const groups = await patternsByGroup();
---
<Base title="UI 패턴 · Regula" current="patterns">
  <Fragment slot="sub">
    {groups.map(({ group: g, items }) => <a href={g.path ? href(g.path) : `#${g.id}`}>{g.level ? `${g.name} · ${items.length}` : g.name}{g.path && ' →'}</a>)}
  </Fragment>

  <PageHead current="patterns" title="언제 쓰고, 언제 피하나">
    <p>컴포넌트가 어떻게 생겼는지보다 언제 쓰고 언제 피하는지를 모읍니다. 미니 목업은 흑백 와이어프레임으로 통일했어요. 실습이 있는 카테고리는 따로 페이지가 있어요.</p>
  </PageHead>

  {groups.map(({ group: g, items }) => (
    <section id={g.id}>
      <header>
        <span class="label">{g.name}</span>
        <h2>{g.title}{g.level && ` ${items.length}가지`}</h2>
        <p>{g.intro}</p>
        {g.path && <a class="open" href={href(g.path)}>실습 페이지로 →</a>}
      </header>
      {g.level && (
        <>
          <IntrusivenessScale names={items.map((p) => p.data.name)} ends={g.ends} />
          <div class="patterns">
            {items.map((p) => <PatternCard pattern={p} />)}
          </div>
        </>
      )}
      {g.level === 'intrusiveness' && (
        <div class="compare">
          <table>
            <thead><tr><th>패턴</th><th>사라지는 방식</th><th>액션</th><th>헷갈리는 짝과의 차이</th><th>출처</th></tr></thead>
            <tbody>
              {items.map(({ data: p }) => (
                <tr>
                  <td>{p.name}</td><td>{p.dismiss}</td><td>{p.actions}</td><td>{p.confused_with}</td>
                  <td class="src-cell">{p.source}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  ))}
</Base>
