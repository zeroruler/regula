---
import { getCollection } from 'astro:content';
import { refGroups } from '../content.config';
import Base from '../layouts/Base.astro';
import FormulaRow from '../components/FormulaRow.astro';
import PatternCard from '../components/PatternCard.astro';
import IntrusivenessScale from '../components/IntrusivenessScale.astro';
import RefItem from '../components/RefItem.astro';
import SeenSync from '../components/SeenSync.astro';
import GoldenRatio from '../demos/GoldenRatio.astro';
import TypeScale from '../demos/TypeScale.astro';
import Contrast from '../demos/Contrast.astro';
import Spacing from '../demos/Spacing.astro';

const formulas = (await getCollection('formulas')).sort((a, b) => a.data.order - b.data.order);
// 같은 카테고리 안에서는 방해 정도 순으로 놓는다 (PLAN §4)
const feedback = (await getCollection('patterns', (p) => p.data.category === '알림'))
  .sort((a, b) => a.data.intrusiveness - b.data.intrusiveness);
const references = (await getCollection('references')).sort((a, b) => a.data.order - b.data.order);
const refTitles = Object.fromEntries(references.map((r) => [r.id, r.data.title]));
---
<Base title="Regula">
  <Fragment slot="toc">
    <span class="label">Regula · v0.2</span>
    <a href="#principles">원리와 공식</a>
    <a href="#tools">계산 도구</a>
    <a href="#patterns">UI 패턴</a>
    <a href="#templates">페이지 양식</a>
    <a href="#references">레퍼런스</a>
    <a href="#log">작업 기록</a>
  </Fragment>

  <div class="hero">
    <span class="label">개인 디자인 규칙집</span>
    <h1><em>Regula</em></h1>
    <p>디자인을 공부하면서 찾은 공식, 화면 패턴, 페이지 양식을 한 곳에 쌓는 노트입니다. 감으로 고르던 값을 이유가 있는 값으로 바꾸는 게 목표예요.</p>
    <div class="etym"><span><b>regula</b> (라틴어)</span><span>① 자, 곧은 막대</span><span>② 규칙, 기준</span></div>
  </div>

  <section id="principles">
    <header>
      <span class="label">§ 1 원리와 공식</span>
      <h2>숫자로 남길 수 있는 것은 숫자로</h2>
      <p>비율, 간격, 글자 크기, 대비처럼 측정할 수 있는 규칙을 모읍니다. 각 항목에 출처를 붙여 두고, 직접 써 본 뒤 메모를 덧붙여 가세요.</p>
    </header>
    <GoldenRatio />
    <div class="formulas">
      {formulas.map((f) => <FormulaRow formula={f} refTitles={refTitles} />)}
    </div>
  </section>

  <section id="tools">
    <header>
      <span class="label">§ 2 계산 도구</span>
      <h2>값을 직접 넣어 보기</h2>
      <p>공식을 외우는 대신 바로 계산해 보는 곳입니다. 작업 중에 열어 두고 쓰면 됩니다.</p>
    </header>
    <div class="tools">
      <TypeScale />
      <Contrast />
      <Spacing />
    </div>
  </section>

  <section id="patterns">
    <header>
      <span class="label">§ 3 UI 패턴 · 알림</span>
      <h2>사용자에게 알려주는 방법 {feedback.length}가지</h2>
      <p>릴스에서 본 9가지를 방해 정도 순으로 다시 놓았습니다. 왼쪽일수록 화면 구석에서 조용히 알리고, 오른쪽일수록 하던 일을 멈추게 합니다. 고를 때는 "이 메시지가 사용자의 흐름을 끊을 자격이 있나"부터 따져 보세요.</p>
    </header>
    <IntrusivenessScale names={feedback.map((p) => p.data.name)} />
    <div class="patterns">
      {feedback.map((p) => <PatternCard pattern={p} />)}
    </div>
    <div class="compare">
      <table>
        <thead><tr><th>패턴</th><th>사라지는 방식</th><th>액션</th><th>헷갈리는 짝과의 차이</th><th>출처</th></tr></thead>
        <tbody>
          {feedback.map(({ data: p }) => (
            <tr>
              <td>{p.name}</td><td>{p.dismiss}</td><td>{p.actions}</td><td>{p.confused_with}</td>
              <td class="src-cell">{p.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="templates">
    <header>
      <span class="label">§ 4 페이지 양식</span>
      <h2>다시 쓸 수 있는 디자인 양식</h2>
      <p>직접 만든 디자인 시스템과 페이지별 양식을 등록하는 곳입니다. 첫 항목은 Lecto에 쓴 Cordovan이에요.</p>
    </header>
    <div class="templates">
      <div class="tpl">
        <span class="label">No.1 · Lecto에서 사용 중</span>
        <h3>Cordovan</h3>
        <div class="cordovan" aria-hidden="true">
          <div style="background:#FFFFFF;color:#555">여백</div>
          <div style="background:#1B1A19;color:#ddd">잉크</div>
          <div style="background:#6B1E24;color:#f1d9d9">옥스블러드</div>
        </div>
        <ul>
          <li>흰 여백을 넓게 쓰고, 글자는 잉크색으로</li>
          <li>강조는 옥스블러드 한 가지만</li>
          <li>라벨은 모노스페이스</li>
          <li>카드·박스를 남발하는 AI스러운 레이아웃을 피함</li>
        </ul>
        <p class="label" style="margin:0">색은 대략적인 표시예요 · DESIGN.md의 실제 토큰으로 교체 예정</p>
      </div>
      <div class="tpl">
        <span class="label">채워 나갈 양식</span>
        <div class="slots">
          <div class="slot"><span>Regula (이 페이지)</span><span>토큰 정리 예정</span></div>
          <div class="slot"><span>랜딩 페이지</span><span>비어 있음</span></div>
          <div class="slot"><span>로그인 · 회원가입</span><span>비어 있음</span></div>
          <div class="slot"><span>설정 화면</span><span>비어 있음</span></div>
          <div class="slot"><span>대시보드</span><span>비어 있음</span></div>
          <div class="slot"><span>글 · 블로그 본문</span><span>비어 있음</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="references">
    <header>
      <span class="label">§ 5 레퍼런스</span>
      <h2>읽고, 보고, 따라 해 볼 것</h2>
      <p>책, 공개 디자인 시스템, 저장소, 커뮤니티를 모았습니다. 제목을 누르면 내 정리와 원문을 이 사이트 안에서 볼 수 있어요. 본 것은 체크해 두세요. 체크 표시는 이 브라우저에만 저장됩니다.</p>
    </header>
    <div class="progress"><span id="refCount">0 / {references.length}</span><div class="meter"><i id="refMeter" style="width:0"></i></div></div>
    <div class="refs">
      {refGroups.map((g) => (
        <div class="refgroup">
          <h3>{g}</h3>
          {references.filter((r) => r.data.group === g).map((r) => <RefItem reference={r} />)}
        </div>
      ))}
    </div>
  </section>

  <section id="log">
    <header>
      <span class="label">§ 6 작업 기록</span>
      <h2>쌓아 온 것, 쌓을 것</h2>
    </header>
    <div class="log">
      <div class="e"><span>2026-10-30</span><span>v0.2 Astro로 옮김. 공식·패턴·레퍼런스를 파일 하나씩으로 나누고, 레퍼런스마다 상세 페이지(내 정리 · 원문 미리보기 · 쓰인 곳)를 붙임. 자유 라이선스 저장소 3곳은 README를 가져와 사이트 안에서 봄.</span></div>
      <div class="e"><span>2026-10-30</span><span>v0.1 시작. 황금비·타입 스케일·간격·대비 공식, 알림 패턴 9가지, Cordovan 양식, 레퍼런스 목록 정리.</span></div>
      <div class="e"><span>다음</span><span>Cordovan 실제 토큰 옮기기 · 색 이론 섹션(색상환, 60-30-10 실습) · 게슈탈트 법칙 도해 · 버튼과 입력창 패턴 추가</span></div>
    </div>
  </section>
  <SeenSync />
</Base>
