---
// 유사성: 간격이 모두 같은 격자에서 한 줄 걸러 한 가지 속성(명도·모양·크기)만 바꾼다. 간격이 같으니 묶음은 생김새로만 생긴다.
const traits = [
  { k: 'same', n: '모두 같음' },
  { k: 'tone', n: '명도' },
  { k: 'shape', n: '모양' },
  { k: 'size', n: '크기' },
];
---
<div class="lab gestalt" id="gSim">
  <svg viewBox="0 0 320 220" role="img" aria-label="한 줄 걸러 생김새가 다른 점 격자"><g class="dots"></g></svg>
  <div class="lab-side">
    <span class="label">유사성 · Similarity</span>
    <h3>닮은 것끼리 묶인다</h3>
    <div class="chips" id="simChips">
      {traits.map((t, i) => <button class="chip" type="button" data-k={t.k} aria-pressed={String(i === 1)}>{t.n}</button>)}
    </div>
    <p class="g-read">보이는 것: <mark id="simRead"></mark></p>
    <p>가로·세로 간격은 똑같습니다. 그런데도 한 가지만 다르게 하면 같은 것끼리 가로줄로 읽혀요. 근접성 없이 생김새만으로 묶이는 겁니다.</p>
    <div class="g-ui">
      <span class="label">UI에서</span>
      <p>같은 역할은 같은 생김새로 둡니다. 본문 링크가 모두 같은 스타일이면 하나만 배워도 나머지를 알아보고, 기능이 다른데 모양이 같으면 같은 것으로 오해해요.</p>
    </div>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#gSim')!;
  const $ = <T extends Element>(s: string) => lab.querySelector<T>(s)!;
  let trait = 'tone';

  function shape(x: number, y: number, odd: boolean) {
    if (!odd || trait === 'same') return `<circle class="g-a" cx="${x}" cy="${y}" r="6.5"/>`;
    if (trait === 'tone') return `<circle class="g-b" cx="${x}" cy="${y}" r="6.5"/>`;
    if (trait === 'shape') return `<rect class="g-a" x="${x - 6}" y="${y - 6}" width="12" height="12"/>`;
    return `<circle class="g-a" cx="${x}" cy="${y}" r="3.5"/>`;
  }
  function render() {
    $('.dots').innerHTML = [0, 1, 2, 3].flatMap((r) => [0, 1, 2, 3, 4, 5].map((c) => shape(60 + c * 40, 50 + r * 40, r % 2 === 1))).join('');
    $('#simRead').textContent = trait === 'same' ? '고른 격자 — 묶음이 없음' : '가로줄 — 같은 것끼리 한 줄로 묶임';
  }
  $('#simChips').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    trait = b.dataset.k!;
    $('#simChips').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    render();
  });
  render();
</script>
