---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PatternCard from '../components/PatternCard.astro';
import IntrusivenessScale from '../components/IntrusivenessScale.astro';

// 같은 카테고리 안에서는 방해 정도 순으로 놓는다 (PLAN §4)
const feedback = (await getCollection('patterns', (p) => p.data.category === '알림'))
  .sort((a, b) => a.data.intrusiveness - b.data.intrusiveness);
---
<Base title="UI 패턴 · Regula" current="patterns">
  <Fragment slot="sub">
    <a href="#feedback">알림 · {feedback.length}</a>
  </Fragment>

  <PageHead current="patterns" title="언제 쓰고, 언제 피하나">
    <p>컴포넌트가 어떻게 생겼는지보다 언제 쓰고 언제 피하는지를 모읍니다. 미니 목업은 흑백 와이어프레임으로 통일했어요.</p>
  </PageHead>

  <section id="feedback">
    <header>
      <span class="label">알림</span>
      <h2>사용자에게 알려주는 방법 {feedback.length}가지</h2>
      <p>릴스에서 본 9가지를 방해 정도 순으로 다시 놓았습니다. 왼쪽일수록 화면 구석에서 조용히 알리고, 오른쪽일수록 하던 일을 멈추게 합니다. 고를 때는 "이 메시지가 사용자의 흐름을 끊을 자격이 있나"부터 따져 보세요.</p>
    </header>
    <IntrusivenessScale names={feedback.map((p) => p.data.name)} />
    <div class="patterns">
      {feedback.map((p) => <PatternCard pattern={p} />)}
    </div>
    <div class="compare">
      <table>
        <thead><tr><th>패턴</th><th>사라지는 방식</th><th>액션</th><th>헷갈리는 짝과의 차이</th><th>출처</th></tr></thead>
        <tbody>
          {feedback.map(({ data: p }) => (
            <tr>
              <td>{p.name}</td><td>{p.dismiss}</td><td>{p.actions}</td><td>{p.confused_with}</td>
              <td class="src-cell">{p.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
