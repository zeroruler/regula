---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormulaRow from '../../components/FormulaRow.astro';
import Weight from '../../demos/composition/Weight.astro';
import Rhythm from '../../demos/composition/Rhythm.astro';
import { topics } from '../../lib/site';
import { href } from '../../lib/url';

const all = (await getCollection('formulas')).sort((a, b) => a.data.order - b.data.order);
const formulas = all.filter((f) => f.data.topic === '조형');
const refTitles = Object.fromEntries((await getCollection('references')).map((r) => [r.id, r.data.title]));

// 『디자인 구구단』 9단이 Regula 어디에 놓였는지. 4단 색과 9단 서체는 기존 주제 페이지에 더했다.
const topicPath = (name: string) => topics.find((t) => t.name === name)?.path ?? 'principles/';
const at = (id: string) => {
  const f = all.find((x) => x.id === id)!;
  return { name: f.data.name, to: f.data.topic === '조형' ? `#f-${id}` : href(`${topicPath(f.data.topic)}#f-${id}`) };
};
const steps: { no: number; name: string; en: string; items: string[] }[] = [
  { no: 1, name: '비율', en: 'Ratio', items: ['ratio-proportion-scale', 'subject-ratio', 'size-hierarchy', 'scale-by-comparison'] },
  { no: 2, name: '공간', en: 'Space', items: ['figure-ground', 'negative-space', 'cast-shadow', 'aerial-perspective'] },
  { no: 3, name: '균형', en: 'Balance', items: ['visual-weight', 'optical-correction', 'symmetry-asymmetry'] },
  { no: 4, name: '색의 속성', en: 'Color', items: ['saturation-contrast', '60-30-10'] },
  { no: 5, name: '질감', en: 'Texture', items: ['texture-contrast'] },
  { no: 6, name: '형과 형태', en: 'Shape & Form', items: ['shape-meaning'] },
  { no: 7, name: '움직임', en: 'Movement', items: ['implied-motion'] },
  { no: 8, name: '율동', en: 'Rhythm', items: ['rhythm'] },
  { no: 9, name: '서체', en: 'Typeface', items: ['type-hierarchy'] },
];
---
<Base title="조형 · 원리와 공식 · Regula" current="principles" description="『디자인 구구단』의 9단(비율·공간·균형·색·질감·형태·움직임·율동·서체)을 공식으로 옮기고, 시각적 무게와 율동을 직접 바꿔 보는 실습 페이지">
  <Fragment slot="sub">
    {topics.map((t, i) => (
      <a href={t.path ? href(t.path) : href(`principles/#t-${i}`)} aria-current={t.name === '조형' ? 'page' : undefined}>{t.name}</a>
    ))}
  </Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('principles/')}>§ 1 원리와 공식</a> · 실습</span>
    <h1>무엇을 먼저 보게 할 것인가</h1>
    <p>크기, 여백, 무게, 결, 형태, 반복 — 화면 위 요소의 생김새로 시선의 순서를 정하는 원리입니다. 에이핫의 <a href={href('references/design-gugudan/')}>『디자인 구구단』</a>이 1단 비율부터 9단 서체까지 나눈 순서를 따라 공식으로 옮겼어요. 책은 그래픽과 사진 중심이라 숫자보다 판단의 기준이 많습니다.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 무게</span>
      <h2>크기만이 무게는 아니다</h2>
      <p>시선은 무거운 것에서 가벼운 것으로 흐릅니다. 크기, 색, 결을 따로 바꿔 보면 서로 상쇄되기도 하고 겹쳐 쌓이기도 해요.</p>
    </header>
    <Weight />
  </section>

  <section>
    <header>
      <span class="label">2 · 율동</span>
      <h2>반복 속의 한 가지 변화</h2>
      <p>같은 것을 되풀이하면 질서가 생기고, 그 안에서 속성 하나만 규칙적으로 바꾸면 흐름이 생깁니다. 여럿을 동시에 바꾸면 반복이 사라져요.</p>
    </header>
    <Rhythm />
  </section>

  <section>
    <header>
      <span class="label">구구단</span>
      <h2>9단이 놓인 곳</h2>
      <p>4단 색과 9단 서체는 원래 있던 색 · 타이포그래피 주제에 더했습니다.</p>
    </header>
    <ol class="c-steps">
      {steps.map((s) => (
        <li>
          <span class="mono">{s.no}단</span>
          <b>{s.name}</b>
          <small class="mono">{s.en}</small>
          <span class="c-links">{s.items.map((id) => at(id)).map((l, i) => <>{i > 0 && ' · '}<a href={l.to}>{l.name}</a></>)}</span>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <header>
      <span class="label">공식</span>
      <h2>조형 원리 {formulas.length}개</h2>
    </header>
    <div class="formulas">
      {formulas.map((f) => <FormulaRow formula={f} refTitles={refTitles} />)}
    </div>
  </section>
</Base>
