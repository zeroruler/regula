---
// 같은 거리를 곡선만 바꿔 움직여 본다. 위는 시간–진행 그래프, 아래는 같은 간격의 시간마다 찍은 위치.
const curves = [
  { k: 'linear', n: '리니어', bz: [0, 0, 1, 1] },
  { k: 'in', n: '이즈 인', bz: [0.42, 0, 1, 1] },
  { k: 'out', n: '이즈 아웃', bz: [0, 0, 0.58, 1] },
  { k: 'inout', n: '이즈 인 아웃', bz: [0.42, 0, 0.58, 1] },
  { k: 'spring', n: '스프링', z: 0.7 },
  { k: 'bounce', n: '바운스', z: 0.3 },
];
---
<div class="lab molab" id="moCurves" data-curves={JSON.stringify(curves)}>
  <div class="mo-fig">
    <svg viewBox="0 0 320 236" role="img" aria-label="시간에 따른 진행 곡선과 위치">
      <g class="mo-grid">
        <line x1="20" y1="20" x2="20" y2="140" /><line x1="20" y1="140" x2="300" y2="140" />
        <line class="mo-goal" x1="20" y1="60" x2="300" y2="60" />
      </g>
      <text class="mo-ax" x="24" y="72">끝</text><text class="mo-ax" x="268" y="156">시간 →</text>
      <path class="mo-curve" id="moPath" d="" />
      <circle class="mo-now" id="moNow" r="4" cx="20" cy="140" />
      <line class="mo-track" x1="20" y1="200" x2="300" y2="200" />
      <g id="moGhosts"></g>
      <circle class="mo-ball" id="moBall" r="9" cx="20" cy="200" />
    </svg>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 곡선과 시간</span>
    <h3>같은 거리, 다른 느낌</h3>
    <div class="chips" id="moKinds">
      {curves.map((c, i) => <button class="chip" type="button" data-k={c.k} aria-pressed={String(i === 2)}>{c.n}</button>)}
    </div>
    <div class="row">
      <label class="label" for="moDur">시간</label>
      <input type="range" id="moDur" min="100" max="1000" step="50" value="300" style="flex:1">
      <span class="mono" id="moDurVal"></span>
    </div>
    <div class="row"><button class="btn-x fill live" type="button" id="moPlay">재생</button><span class="mono mo-css" id="moCss"></span></div>
    <p class="g-read" aria-live="polite">판정: <mark id="moRead"></mark></p>
    <p id="moNote"></p>
    <div class="g-ui">
      <span class="label">UI에서</span>
      <p>들어오는 것은 이즈 아웃, 나가는 것은 이즈 인, 손으로 끌던 것은 스프링. 대부분의 UI 움직임은 0.1–0.5초 안에 끝납니다. 움직임 줄이기 설정이면 공 대신 찍힌 위치만 보여 줘요.</p>
    </div>
  </div>
</div>

<script>
  type C = { k: string; n: string; bz?: number[]; z?: number };
  const lab = document.querySelector<HTMLElement>('#moCurves')!;
  const curves: C[] = JSON.parse(lab.dataset.curves!);
  const $ = (id: string) => lab.querySelector<SVGElement & HTMLElement>(`#${id}`)!;
  const dur = $('moDur') as unknown as HTMLInputElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cur = curves[2], raf = 0;

  // cubic-bezier: x(s)=t를 풀어 y(s)를 돌려준다
  function bezier([x1, y1, x2, y2]: number[]) {
    const f = (a: number, b: number, s: number) => 3 * a * s * (1 - s) ** 2 + 3 * b * s * s * (1 - s) + s ** 3;
    return (t: number) => {
      let lo = 0, hi = 1, s = t;
      for (let i = 0; i < 30; i++) { s = (lo + hi) / 2; if (f(x1, x2, s) < t) lo = s; else hi = s; }
      return f(y1, y2, s);
    };
  }
  // 감쇠 진동: 정해진 시간(T) 안에 거의 멈추도록 고유 진동수를 정한다
  function spring(z: number) {
    const w = 4.6 / z;
    const wd = w * Math.sqrt(1 - z * z);
    return (t: number) => 1 - Math.exp(-z * w * t) * (Math.cos(wd * t) + ((z * w) / wd) * Math.sin(wd * t));
  }
  const ease = (c: C) => (c.bz ? bezier(c.bz) : spring(c.z!));
  const X = (p: number) => 20 + p * 280;
  const Y = (v: number) => 140 - v * 80;

  function draw() {
    const e = ease(cur);
    const pts = Array.from({ length: 81 }, (_, i) => `${i ? 'L' : 'M'}${X(i / 80).toFixed(1)},${Y(e(i / 80)).toFixed(1)}`);
    $('moPath').setAttribute('d', pts.join(''));
    $('moGhosts').innerHTML = Array.from({ length: 9 }, (_, i) => `<circle class="mo-ghost" r="4" cx="${X(Math.min(1.08, Math.max(-0.02, e(i / 8)))).toFixed(1)}" cy="200" />`).join('');
    const ms = +dur.value;
    $('moDurVal').textContent = `${ms}ms`;
    $('moCss').textContent = cur.bz ? `cubic-bezier(${cur.bz.join(', ')})` : `스프링 · 감쇠비 ${cur.z}`;
    $('moRead').textContent = ms < 150 ? '너무 빨라 움직임이 거의 안 보임' : ms <= 500 ? 'UI 움직임의 보통 범위' : '느리게 느껴짐 — 큰 화면 전환이 아니면 길다';
    const notes: Record<string, string> = {
      linear: '처음부터 끝까지 같은 속도. 기계처럼 보여서 UI보다는 진행 막대나 회전에 씁니다.',
      in: '천천히 출발해 끝에서 빨라집니다. 위치 점이 오른쪽으로 몰려 있죠 — 떠나는 것에 맞아요.',
      out: '빠르게 출발해 끝에서 천천히. 점이 왼쪽에 몰려 있어 바로 반응한 것처럼 보이고, 도착 자리를 따라갈 수 있습니다.',
      inout: '양 끝이 모두 부드럽습니다. 화면 안에서 자리만 옮기는 움직임에 맞아요.',
      spring: '목표선을 살짝 넘었다가 돌아옵니다. 시간이 아니라 단단함과 마찰로 정해지는 움직임.',
      bounce: '여러 번 넘쳤다 돌아옵니다. 눈길을 끌지만 길고 산만해서 드물게만.',
    };
    $('moNote').textContent = notes[cur.k];
    $('moBall').setAttribute('cx', String(X(1)));
    $('moNow').setAttribute('cx', String(X(1)));
    $('moNow').setAttribute('cy', String(Y(1)));
  }

  function play() {
    cancelAnimationFrame(raf);
    if (reduce) return draw();
    const e = ease(cur), ms = +dur.value, t0 = performance.now();
    const step = () => {
      const t = Math.min(1, (performance.now() - t0) / ms);
      const v = e(t);
      $('moBall').setAttribute('cx', X(v).toFixed(1));
      $('moNow').setAttribute('cx', X(t).toFixed(1));
      $('moNow').setAttribute('cy', Y(v).toFixed(1));
      if (t < 1) raf = requestAnimationFrame(step);
    };
    step();
  }

  $('moKinds').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    cur = curves.find((c) => c.k === b.dataset.k)!;
    $('moKinds').querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    draw();
    play();
  });
  dur.addEventListener('input', draw);
  $('moPlay').addEventListener('click', play);
  draw();
</script>
