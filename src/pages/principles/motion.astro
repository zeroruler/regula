---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormulaRow from '../../components/FormulaRow.astro';
import Curves from '../../demos/motion/Curves.astro';
import Transitions from '../../demos/motion/Transitions.astro';
import { topics } from '../../lib/site';
import { href } from '../../lib/url';
import Cite from '../../components/Cite.astro';
import { rulesOf, ruleId } from '../../lib/rules';

const T = '움직임';
const formulas = (await getCollection('formulas', (f) => f.data.topic === T)).sort((a, b) => a.data.order - b.data.order);
const refTitles = Object.fromEntries((await getCollection('references')).map((r) => [r.id, r.data.title]));

const { rules } = rulesOf('motion');
---
<Base title="움직임 · 원리와 공식 · Regula" current="principles" description="이즈 인 · 이즈 아웃 · 스프링 같은 움직임의 이름을 곡선과 시간으로 재생해 보고, 화면 전환 다섯 가지를 직접 눌러 보는 페이지">
  <Fragment slot="sub">
    {topics.map((t, i) => (
      <a href={t.path ? href(t.path) : href(`principles/#t-${i}`)} aria-current={t.name === T ? 'page' : undefined}>{t.name}</a>
    ))}
  </Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('principles/')}>§ 1 원리와 공식</a> · 실습</span>
    <h1>부드럽게 말고, 이름으로</h1>
    <p>"부드럽게 해 주세요"는 사람마다 다르게 들립니다. 움직임에는 이름과 숫자가 있어요 — 곡선(이즈 아웃), 시간(250ms), 전환의 종류(확대 전환). 이름으로 말하면 원하는 움직임이 그대로 나옵니다. 아래 실습은 움직임 줄이기 설정을 켜 두면 움직이지 않고 결과만 보여 줘요.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 곡선과 시간</span>
      <h2>같은 거리, 다른 속도</h2>
      <p>곡선을 바꾸고 시간을 늘려 재생해 보세요. 아래 줄의 점들은 같은 시간 간격마다 찍은 위치라, 점이 몰린 곳이 느린 구간입니다.</p>
    </header>
    <Curves />
  </section>

  <section>
    <header>
      <span class="label">2 · 화면 전환</span>
      <h2>새 화면은 어디서 왔나</h2>
      <p>같은 목록 → 상세를 다섯 가지 전환으로 열어 봅니다. 전환마다 두 화면의 관계를 다르게 말해요.</p>
    </header>
    <Transitions />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r, i) => <tr id={ruleId('motion', i)}><td>{r.s}</td><td>{r.rule}</td><td class="src-cell"><Cite text={r.src} /></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <header>
      <span class="label">이름</span>
      <h2>움직임 이름 {formulas.length}가지</h2>
      <p>AI나 개발자에게 넘길 때는 이름과 함께 시간과 곡선 값을 같이 적으세요. "카드 확대 전환, 300ms, ease-in-out"처럼.</p>
    </header>
    <div class="formulas">
      {formulas.map((f) => <FormulaRow formula={f} refTitles={refTitles} />)}
    </div>
  </section>
</Base>
