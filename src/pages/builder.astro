---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { href } from '../lib/url';
import { loadCombos } from '../lib/combos';

// 서체 후보는 fonts 컬렉션에서 가져온다. 클라이언트 스크립트가 이 JSON으로 선택지와 서체 파일 주소를 만든다.
const fonts = (await getCollection('fonts')).sort((a, b) => a.data.order - b.data.order).map((f) => ({
  id: f.id, name: f.data.name, family: f.data.family, kind: f.data.kind, script: f.data.script, load: f.data.load,
}));
const origin = { styles: href('principles/styles/'), motion: href('principles/motion/'), spacing: href('principles/spacing/'), colors: href('colors/') };
// 색 조합은 /colors/와 같은 데이터(src/content/combos)를 빌드 때 풀어 넘긴다.
const combos = (await loadCombos()).map((c) => c.option);

// 도구가 쓰는 기준 중 출처가 있는 것만. 원문 확인 기록은 docs/source-check.md (15차).
const rules = [
  { s: '글자 대비', rule: '본문 글자는 배경과 4.5:1 이상. 도구는 글자 · 보조 글자 · 강조색 · 알림 · 위험 버튼의 조합을 계산해 미달을 표시한다', src: 'WCAG 2.2 1.4.3 Contrast (Minimum) (AA)' },
  { s: '경계 · 포커스', rule: '입력칸 경계와 포커스 링은 주변과 3:1 이상. 그래서 입력칸 테두리는 두께 0이어도 1px를 남긴다', src: 'WCAG 2.2 1.4.11 Non-text Contrast (AA)' },
  { s: '색에만 기대지 않기', rule: '파일의 알림 견본은 색과 함께 "안내 · 완료 · 오류" 글자를 쓴다', src: 'WCAG 2.2 1.4.1 Use of Color (A)' },
  { s: '반투명 면', rule: '반투명 면 위 글자는 가장 나쁜 배경에서도 4.5:1. 투명도 줄이기 · 대비 높이기 설정에는 불투명한 면으로 — DESIGN.md와 preview.html에 미디어 쿼리가 들어간다', src: 'Megan Brown, 「Glassmorphism: Definition and Best Practices」 (NN/g, 2024) · W3C Media Queries Level 5 (prefers-reduced-transparency · prefers-contrast, 2026-02-19 Working Draft 원문에서 이름 확인)' },
  { s: '움직임 줄이기', rule: 'prefers-reduced-motion이면 전환을 끈다. 5초 넘게 저절로 움직이는 것은 멈출 수단을 둔다', src: 'WCAG 2.2 2.3.3 Animation from Interactions (AAA) · 2.2.2 Pause, Stop, Hide (A)' },
  { s: '곡선', rule: '표준 cubic-bezier(0.2, 0, 0, 1) · 감속 (0, 0, 0, 1) · 가속 (0.3, 0, 1, 1)', src: 'Material 3 토큰 md.sys.motion (material-web 저장소 tokens/versions/v0_192)' },
  { s: '컨트롤 크기', rule: '최소 24×24px(AA), 44×44px이면 향상 기준(AAA)까지', src: 'WCAG 2.2 2.5.8 Target Size (Minimum) · 2.5.5 Target Size (Enhanced)' },
];
// 이 도구가 정한 값 — 출처가 있는 기준이 아니다.
const own = [
  { s: '색 계산', rule: '호버 = 강조색에 검정(다크는 흰색) 12% 섞기, 눌림 24%, 부드러운 배경 = 표면에 색 12% 섞기, 강조색 위 글자 = 표면색과 글자색 중 대비가 큰 쪽' },
  { s: '그림자 단계', rule: '흐린 그림자 4단계의 y · 번짐 · 투명도, 어긋난 그림자 2/4/6/8px, 한 쌍 3/6/10/16px — 단계 값은 이 도구가 정함. 카드는 고른 단계, 버튼은 한 단계 아래, 떠 있는 것은 한 단계 위' },
  { s: '간격 · 밀도', rule: '8단계 배수(1 2 3 4 6 8 12 16 × 단위), 밀도별 컨트롤 · 카드 · 요소 · 섹션 간격' },
  { s: '시간 묶음', rule: '빠름 100/200/300 · 보통 150/300/500 · 느림 200/400/600ms. UI 움직임이 대개 0.1–0.5초라는 범위 안에서 정한 조합' },
  { s: '색 조합', rule: '조합의 바탕 · 면 · 글자 · 주 강조 · 오류 · 성공은 그대로 옮기고, 보조 글자 = 글자 75% + 면 25%, 선 = 면 84% + 글자 16%, 입력칸 테두리 = 면과 글자 반반으로 섞는다. 보조 색은 DESIGN.md에만. 어떤 색을 묶을지는 Regula가 고른 것' },
  { s: '스타일 프리셋', rule: '비주얼 스타일 9가지의 재료를 CSS 값으로 옮긴 근사. 같은 이름의 스타일이어도 실제 서비스마다 다르다' },
];
---
<Base title="디자인 파일 만들기 · Regula" current="builder" description="서체, 모서리, 효과, 색, 간격, 움직임을 골라 미리보고 AI 에이전트가 읽는 DESIGN.md와 tokens.json으로 내려받는 도구">
  <PageHead current="builder" title="골라 보고, 파일로 받기">
    <p>디자인 시스템의 세부사항을 직접 고르면 버튼 · 입력 · 카드 · 알림 · 목록이 바로 바뀝니다. 마음에 들면 AI 에이전트(Claude Code 등)가 읽는 <code>DESIGN.md</code>와 <code>tokens.json</code>으로 받으세요. <a href={href('templates/')}>페이지 양식</a>의 <code>DESIGN/&lt;이름&gt;/</code> 폴더와 같은 모양이라 저장소에 그대로 넣을 수 있어요.</p>
  </PageHead>

  <section class="bd-sec">
    <script type="application/json" id="bdFonts" set:html={JSON.stringify(fonts)}></script>
    <script type="application/json" id="bdOrigin" set:html={JSON.stringify(origin)}></script>
    <script type="application/json" id="bdCombos" set:html={JSON.stringify(combos)}></script>
    <div class="bd" id="bd"><noscript><p class="bd-note">이 도구는 스크립트로 동작합니다. 스크립트를 켜 주세요.</p></noscript></div>
  </section>

  <section>
    <header>
      <span class="label">근거</span>
      <h2>출처가 있는 기준, 이 도구가 정한 값</h2>
      <p>대비 · 움직임 같은 기준은 이 사이트에서 원문을 읽고 확인한 것만 씁니다(<code>docs/source-check.md</code> 15차). 나머지는 도구가 설정에서 계산한 값이고, 내려받는 파일에도 그렇게 적습니다.</p>
    </header>
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>{rules.map((r) => <tr><td>{r.s}</td><td>{r.rule}</td><td class="src-cell">{r.src}</td></tr>)}</tbody>
      </table>
    </div>
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>이 도구가 정한 값 (출처 없음)</th></tr></thead>
        <tbody>{own.map((r) => <tr><td>{r.s}</td><td>{r.rule}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import { initBuilder } from '../lib/builder/ui';
  const host = document.querySelector<HTMLElement>('#bd')!;
  const fonts = JSON.parse(document.querySelector('#bdFonts')!.textContent!);
  const origin = JSON.parse(document.querySelector('#bdOrigin')!.textContent!);
  const combos = JSON.parse(document.querySelector('#bdCombos')!.textContent!);
  initBuilder(host, fonts, origin, combos);
</script>
