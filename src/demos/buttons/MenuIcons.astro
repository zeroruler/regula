---
// 메뉴 아이콘 별명 9가지. 별명은 비공식 통칭이라, 공식 이름이 있는 쪽(Material Icons 이름)을 같이 적는다.
// 그림은 Regula가 그린 흑백 도형이고 Material 아이콘 패스를 옮기지 않았다.
// ok: 별명을 릴스 밖의 출처에서 확인했는지
const icons = [
  {
    no: '01', ko: '햄버거', en: 'Hamburger', opens: '내비게이션 메뉴(드로어)를 연다', md: 'menu', ok: true,
    note: '위키백과 Hamburger button',
    svg: '<rect x="4" y="6" width="16" height="2" rx="1"/><rect x="4" y="11" width="16" height="2" rx="1"/><rect x="4" y="16" width="16" height="2" rx="1"/>',
  },
  {
    no: '02', ko: '케밥', en: 'Kebab', opens: '그 항목에 대한 행동 더보기(수정 · 삭제 · 공유)', md: 'more_vert', ok: true,
    note: '위키백과는 세로 점 셋을 케밥 · 미트볼 · 팔라펠 어느 것으로도 부른다고 적음',
    svg: '<circle cx="12" cy="6" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="18" r="2"/>',
  },
  {
    no: '03', ko: '미트볼', en: 'Meatballs', opens: '케밥과 같은 더보기. 방향만 가로', md: 'more_horiz', ok: true,
    note: '미트볼을 세로 점에 쓰는 글도 있어 이름이 갈린다',
    svg: '<circle cx="6" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18" cy="12" r="2"/>',
  },
  {
    no: '04', ko: '와플', en: 'Waffle', opens: '다른 앱 · 서비스로 건너가는 앱 목록', md: '—', ok: true,
    note: '위키백과는 와플을 3×3 네모로 적음. 릴스는 점으로 그림',
    svg: '<circle cx="6" cy="6" r="1.8"/><circle cx="12" cy="6" r="1.8"/><circle cx="18" cy="6" r="1.8"/><circle cx="6" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="18" cy="12" r="1.8"/><circle cx="6" cy="18" r="1.8"/><circle cx="12" cy="18" r="1.8"/><circle cx="18" cy="18" r="1.8"/>',
  },
  {
    no: '05', ko: '벤토', en: 'Bento', opens: '와플과 같은 앱 목록', md: 'apps', ok: true,
    note: 'Material의 apps가 3×3 네모',
    svg: '<rect x="4" y="4" width="4" height="4" rx="1"/><rect x="10" y="4" width="4" height="4" rx="1"/><rect x="16" y="4" width="4" height="4" rx="1"/><rect x="4" y="10" width="4" height="4" rx="1"/><rect x="10" y="10" width="4" height="4" rx="1"/><rect x="16" y="10" width="4" height="4" rx="1"/><rect x="4" y="16" width="4" height="4" rx="1"/><rect x="10" y="16" width="4" height="4" rx="1"/><rect x="16" y="16" width="4" height="4" rx="1"/>',
  },
  {
    no: '06', ko: '도너', en: 'Döner', opens: '목록 거르기(필터)', md: 'filter_list', ok: false,
    note: '별명은 릴스에서만 봄. 모양은 Material filter_list와 같다',
    svg: '<rect x="3" y="6" width="18" height="2" rx="1"/><rect x="6" y="11" width="12" height="2" rx="1"/><rect x="10" y="16" width="4" height="2" rx="1"/>',
  },
  {
    no: '07', ko: '베지 버거', en: 'Veggie burger', opens: '줄이 둘뿐인 햄버거', md: 'drag_handle', ok: false,
    note: 'Material에서 두 줄은 "끌어서 옮기기" 손잡이라 메뉴로 쓰면 뜻이 겹친다',
    svg: '<rect x="4" y="9" width="16" height="2" rx="1"/><rect x="4" y="13" width="16" height="2" rx="1"/>',
  },
  {
    no: '08', ko: '계단', en: 'Stairs', opens: '줄 길이가 계단처럼 어긋남. 정렬 · 목차에 가깝다', md: 'sort · segment', ok: false,
    note: '별명은 릴스에서만 봄. 비슷한 꼴의 Material 아이콘이 둘',
    svg: '<rect x="3" y="6" width="10" height="2" rx="1"/><rect x="6" y="11" width="10" height="2" rx="1"/><rect x="9" y="16" width="12" height="2" rx="1"/>',
  },
  {
    no: '09', ko: '슬라이더', en: 'Sliders', opens: '설정 조절 · 상세 필터', md: 'tune', ok: false,
    note: '별명은 릴스에서만 봄. 모양은 Material tune과 같다',
    svg: '<rect x="3" y="7" width="18" height="2" rx="1"/><rect x="3" y="15" width="18" height="2" rx="1"/><circle cx="9" cy="8" r="3" class="hole"/><circle cx="15" cy="16" r="3" class="hole"/>',
  },
];
---
<div class="mic-grid">
  {icons.map((i) => (
    <article class="mic">
      <div class="mic-art"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" set:html={i.svg} /></div>
      <h3><span class="mic-no">{i.no}</span>{i.ko}</h3>
      <p class="mic-en">{i.en}{!i.ok && <span class="mic-tag">출처 미확인</span>}</p>
      <p class="mic-opens">{i.opens}</p>
      <p class="mic-md"><code>{i.md}</code></p>
      <p class="mic-note">{i.note}</p>
    </article>
  ))}
</div>

<style>
  .mic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin-top:24px;border:1px solid var(--rule);background:var(--rule)}
  @media (max-width:640px){.mic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.mic:last-child{grid-column:1/-1}}
  .mic{background:var(--surface);padding:16px;min-width:0}
  .mic-art{display:grid;place-items:center;height:72px;border:1px solid var(--rule);background:var(--paper);margin-bottom:12px;color:var(--ink)}
  .mic-art svg{fill:currentColor}
  .mic-art :global(.hole){fill:var(--paper);stroke:currentColor;stroke-width:2}
  .mic h3{font-size:16px;margin:0;display:flex;gap:8px;align-items:baseline}
  .mic-no{font-family:var(--mono);font-size:11.5px;color:var(--ink-3)}
  .mic p{margin:4px 0 0;font-size:13px;line-height:1.5}
  .mic-en{color:var(--ink-3)}
  .mic-tag{font-family:var(--mono);font-size:10.5px;margin-left:6px;padding:0 4px;white-space:nowrap;border:1px solid var(--rule)}
  .mic-opens{color:var(--ink)}
  .mic-md code{font-family:var(--mono);font-size:11.5px;overflow-wrap:anywhere}
  .mic-note{color:var(--ink-3);font-size:12px}
</style>
