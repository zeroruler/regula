---
const sp = [4, 8, 12, 16, 24, 32, 48, 64, 96, 128];
---
<div class="tool" style="grid-column:1/-1">
  <span class="label">간격 스케일 · Refactoring UI 방식</span>
  <h3>인접한 값은 25% 이상 차이 나게</h3>
  <div class="bars">
    {sp.map((v, i) => (
      <div class="bar"><span>{v}</span><i style={`width:${(v / 128) * 100}%`}></i><span>{i ? `+${Math.round((v / sp[i - 1] - 1) * 100)}%` : '기준'}</span></div>
    ))}
  </div>
</div>
