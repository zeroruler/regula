---
import Ruler from '../components/Ruler.astro';
import { nav, version, type SectionKey } from '../lib/site';
import { href } from '../lib/url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // 지금 보고 있는 페이지가 속한 섹션. 내비게이션에서 표시하고, sub 슬롯을 그 아래에 펼친다.
  current?: SectionKey;
}
const { title, description = '디자인 공식, UI 패턴, 페이지 양식을 쌓는 개인 디자인 규칙집', current } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@500;700&family=IBM+Plex+Sans+KR:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
</head>
<body>
<Ruler />
<div class="wrap">
<div class="shell">
  <nav class="toc" aria-label="사이트">
    <a class="brand" href={href()} aria-current={current ? undefined : 'page'}>Regula <span>{version}</span></a>
    {nav.map((g) => (
      <div class="navgroup">
        <span class="label">{g.group}</span>
        {g.items.map((s) => (
          <>
            <a href={href(s.path)} aria-current={s.key === current ? 'page' : undefined}>{s.title}</a>
            {s.key === current && Astro.slots.has('sub') && <div class="subnav"><slot name="sub" /></div>}
          </>
        ))}
      </div>
    ))}
  </nav>
  <main><slot /></main>
</div>
<footer>Regula · zero_ruler의 디자인 규칙집 · 출처가 표시된 내용은 각 원저자의 것입니다.</footer>
</div>
</body>
</html>
