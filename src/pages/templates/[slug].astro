---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isColor } from '../../lib/design-tokens';
import { loadTemplate } from '../../lib/templates';
import { loadThemes } from '../../lib/themes';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const all = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);
  return all.map((template, i) => ({ params: { slug: template.id }, props: { template, all, prev: all[i - 1], next: all[i + 1] } }));
}

const { template, all, prev, next } = Astro.props;
const t = template.data;
const { Content } = await render(template);
const { source, groups, strip, preview, doc, markdown } = loadTemplate(template);
const tokenCount = groups.reduce((n, g) => n + g.tokens.length, 0);
const isPage = t.kind === '페이지 양식';
const themes = isPage ? await loadThemes() : [];
---
<Base title={`${t.name} · Regula`} description={t.concept} current="templates">
  <Fragment slot="sub">
    {all.map((s) => <a href={href(`templates/${s.id}/`)} aria-current={s.id === template.id ? 'page' : undefined}>{s.data.name}</a>)}
  </Fragment>

  <article class="refdoc">
    <header class="ref-head">
      <span class="label"><a href={href('templates/')}>§ 4 페이지 양식</a> · {t.kind}</span>
      <h1>{t.name}</h1>
      <p class="lede">{t.concept}</p>
      {strip.length > 0 && <div class="strip" aria-hidden="true">{strip.map((s) => <i style={`background:${s.value}`}></i>)}</div>}
      {!isPage && <p class="by">{t.used_in.length ? `사용처 · ${t.used_in.join(', ')}` : '사용처 · 아직 기록 없음'}</p>}
      <div class="row">
        {preview && <a class="open" href={preview} target="_blank" rel="noopener">미리보기 새 탭에서 열기 ↗</a>}
        {doc && <a class="open" href={doc} target="_blank" rel="noopener">전체 문서 (DESIGN.html) ↗</a>}
        {markdown && <a class="open" href={markdown} target="_blank" rel="noopener">DESIGN.md ↗</a>}
      </div>
    </header>

    {isPage && (
      <section class="rules">
        <div>
          <h2 class="label">구성 · 위에서 아래로</h2>
          <ol class="parts">{t.parts.map((p) => <li><b>{p.name}</b>{p.optional && <span class="opt">선택</span>}{p.note && <small>{p.note}</small>}</li>)}</ol>
        </div>
        <div>
          <h2 class="label">규칙 · {t.rules.length}</h2>
          <ol class="parts">{t.rules.map((r) => <li>{r.text}<small class="src">{r.source}</small></li>)}</ol>
          {t.see.length > 0 && <p class="see"><span class="label">이어 보기</span>{t.see.map((l) => <a href={href(l.path)}>{l.label}</a>)}</p>}
        </div>
      </section>
    )}

    {isPage && preview && (
      <section>
        <h2 class="label">미리보기 · 디자인 시스템을 바꿔 입혀 보기</h2>
        <div class="row switch" data-base={preview}>
          <div class="chips" role="group" aria-label="디자인 시스템">
            {themes.map((th, i) => <button class="chip" type="button" data-system={th.id} aria-pressed={String(i === 0)}>{th.name}</button>)}
          </div>
          <div class="chips" role="group" aria-label="상태">
            {t.states.map((s, i) => <button class="chip" type="button" data-state={s.key} aria-pressed={String(i === 0)}>{s.label}</button>)}
          </div>
        </div>
        <div class="frame"><iframe id="pagePreview" src={`${preview}?system=${themes[0]?.id}`} title={`${t.name} 미리보기`}></iframe></div>
        {t.preview_note && <p class="credit">{t.preview_note}</p>}
      </section>
    )}

    {t.signatures.length > 0 && <section class="rules">
      <div>
        <h2 class="label">시그니처</h2>
        <ol>{t.signatures.map((s) => <li>{s}</li>)}</ol>
      </div>
      {t.avoid.length > 0 && (
        <div>
          <h2 class="label">피하는 것</h2>
          <ul>{t.avoid.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
    </section>}

    {!isPage && preview && (
      <section>
        <h2 class="label">미리보기</h2>
        <div class="frame"><iframe src={preview} title={`${t.name} 미리보기`} loading="lazy"></iframe></div>
      </section>
    )}

    {source && <section>
      <h2 class="label">디자인 토큰 · {tokenCount}개</h2>
      <p class="credit">원본 <code>{source}</code> — 이 표는 빌드할 때 원본에서 바로 읽어 와서, 원본을 고치면 따라 바뀝니다.</p>
      {groups.map((g) => (
        <div class="tokgroup">
          <h3>{g.title}{g.note && <small>{g.note}</small>}</h3>
          <div class="compare">
            <table class="tokens">
              <thead><tr><th>토큰</th><th>라이트</th><th>다크</th><th>메모</th></tr></thead>
              <tbody>
                {g.tokens.map((k) => (
                  <tr>
                    <td><code>{k.name}</code></td>
                    <td>{isColor(k.value) && <i class="sw" style={`background:${k.value}`}></i>}<code>{k.value}</code></td>
                    <td>{k.dark && <>{isColor(k.dark) && <i class="sw" style={`background:${k.dark}`}></i>}<code>{k.dark}</code></>}</td>
                    <td>{k.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </section>}

    <section>
      <h2 class="label">메모</h2>
      <div class="prose"><Content /></div>
    </section>

    <nav class="pager" aria-label="이전·다음 양식">
      {prev ? <a href={href(`templates/${prev.id}/`)}><span class="label">← 이전</span>{prev.data.name}</a> : <span></span>}
      {next && <a class="next" href={href(`templates/${next.id}/`)}><span class="label">다음 →</span>{next.data.name}</a>}
    </nav>
  </article>
</Base>

<script>
  // 미리보기의 디자인 시스템·상태 바꾸기
  const box = document.querySelector<HTMLElement>('.switch');
  const frame = document.querySelector<HTMLIFrameElement>('#pagePreview');
  // 미리보기 iframe을 안쪽 내용 높이에 맞춘다. 상태(오류 문구)나 화면 너비에 따라 카드 높이가 달라져서
  // 고정 높이로 두면 휴대폰에서 아래가 잘린다.
  if (frame) {
    let observer: ResizeObserver | undefined;
    const fit = () => {
      const doc = frame.contentDocument;
      // 높이에는 iframe 자신의 위아래 테두리도 들어간다 (box-sizing: border-box)
      const border = frame.offsetHeight - frame.clientHeight;
      if (doc?.body) frame.style.height = `${doc.body.scrollHeight + border}px`;
    };
    const watch = () => {
      observer?.disconnect();
      const body = frame.contentDocument?.body;
      if (!body) return;
      observer = new ResizeObserver(fit);
      observer.observe(body);
      fit();
    };
    frame.addEventListener('load', watch);
    // 이 스크립트보다 iframe이 먼저 다 읽혔을 수 있다
    if (frame.contentDocument?.readyState === 'complete') watch();
  }
  if (box && frame) {
    const pick = { system: box.querySelector<HTMLElement>('button[data-system]')!.dataset.system!, state: box.querySelector<HTMLElement>('button[data-state]')?.dataset.state ?? 'default' };
    box.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      const key = b.dataset.system ? 'system' : 'state';
      pick[key] = (b.dataset.system ?? b.dataset.state)!;
      b.parentElement!.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      frame.src = `${box.dataset.base}?system=${pick.system}&state=${pick.state}`;
    });
  }
</script>
