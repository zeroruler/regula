---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isColor } from '../../lib/design-tokens';
import { loadTemplate } from '../../lib/templates';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const all = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);
  return all.map((template, i) => ({ params: { slug: template.id }, props: { template, all, prev: all[i - 1], next: all[i + 1] } }));
}

const { template, all, prev, next } = Astro.props;
const t = template.data;
const { Content } = await render(template);
const { source, groups, strip, preview, doc, markdown } = loadTemplate(template);
const tokenCount = groups.reduce((n, g) => n + g.tokens.length, 0);
---
<Base title={`${t.name} · Regula`} description={t.concept}>
  <Fragment slot="toc">
    <span class="label"><a href={href('#templates')}>← Regula</a></span>
    <span class="label toc-group">페이지 양식</span>
    {all.map((s) => <a href={href(`templates/${s.id}/`)} aria-current={s.id === template.id ? 'page' : undefined}>{s.data.name}<small>{s.data.kind}</small></a>)}
  </Fragment>

  <article class="refdoc">
    <header class="ref-head">
      <span class="label">§ 4 페이지 양식 · {t.kind}</span>
      <h1>{t.name}</h1>
      <p class="lede">{t.concept}</p>
      <div class="strip" aria-hidden="true">{strip.map((s) => <i style={`background:${s.value}`}></i>)}</div>
      <p class="by">{t.used_in.length ? `사용처 · ${t.used_in.join(', ')}` : '사용처 · 아직 기록 없음'}</p>
      <div class="row">
        {preview && <a class="open" href={preview} target="_blank" rel="noopener">미리보기 새 탭에서 열기 ↗</a>}
        {doc && <a class="open" href={doc} target="_blank" rel="noopener">전체 문서 (DESIGN.html) ↗</a>}
        {markdown && <a class="open" href={markdown} target="_blank" rel="noopener">DESIGN.md ↗</a>}
      </div>
    </header>

    <section class="rules">
      <div>
        <h2 class="label">시그니처</h2>
        <ol>{t.signatures.map((s) => <li>{s}</li>)}</ol>
      </div>
      {t.avoid.length > 0 && (
        <div>
          <h2 class="label">피하는 것</h2>
          <ul>{t.avoid.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
    </section>

    {preview && (
      <section>
        <h2 class="label">미리보기</h2>
        <div class="frame"><iframe src={preview} title={`${t.name} 미리보기`} loading="lazy"></iframe></div>
      </section>
    )}

    <section>
      <h2 class="label">디자인 토큰 · {tokenCount}개</h2>
      <p class="credit">원본 <code>{source}</code> — 이 표는 빌드할 때 원본에서 바로 읽어 와서, 원본을 고치면 따라 바뀝니다.</p>
      {groups.map((g) => (
        <div class="tokgroup">
          <h3>{g.title}{g.note && <small>{g.note}</small>}</h3>
          <div class="compare">
            <table class="tokens">
              <thead><tr><th>토큰</th><th>라이트</th><th>다크</th><th>메모</th></tr></thead>
              <tbody>
                {g.tokens.map((k) => (
                  <tr>
                    <td><code>{k.name}</code></td>
                    <td>{isColor(k.value) && <i class="sw" style={`background:${k.value}`}></i>}<code>{k.value}</code></td>
                    <td>{k.dark && <>{isColor(k.dark) && <i class="sw" style={`background:${k.dark}`}></i>}<code>{k.dark}</code></>}</td>
                    <td>{k.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </section>

    <section>
      <h2 class="label">메모</h2>
      <div class="prose"><Content /></div>
    </section>

    <nav class="pager" aria-label="이전·다음 양식">
      {prev ? <a href={href(`templates/${prev.id}/`)}><span class="label">← 이전</span>{prev.data.name}</a> : <span></span>}
      {next && <a class="next" href={href(`templates/${next.id}/`)}><span class="label">다음 →</span>{next.data.name}</a>}
    </nav>
  </article>
</Base>
