---
import { render } from 'astro:content';
import { noteKinds } from '../content.config';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { allNotes, resolve } from '../lib/items';
import { href } from '../lib/url';

// 기록장: 날짜별로 묶는다. 위가 최신.
const notes = await allNotes();
const rows = await Promise.all(notes.map(async (n) => ({ n, items: await Promise.all(n.data.about.map(resolve)), Content: (await render(n)).Content })));
const dates = [...new Set(notes.map((n) => n.data.date))];
const count = (k: string) => notes.filter((n) => n.data.kind === k).length;
---
<Base title="출처 기록 · Regula" current="notes" description="Regula의 자료를 어디서 봤는지 날짜별로 남긴 출처 기록">
  <Fragment slot="sub">
    {dates.map((d) => <a href={`#d-${d}`}>{d}</a>)}
  </Fragment>

  <PageHead current="notes" title="어디서 봤는지 남긴 말">
    <p>Regula의 자료가 어디서 왔는지 남기는 곳입니다. 릴스나 책에서 <b>본 것</b>을 날짜별로 두고, 기록이 가리키는 공식 · 패턴 아래에도 "본 곳"으로 붙습니다.</p>
  </PageHead>

  <section class="notes">
    <div class="chips" id="noteKinds" role="group" aria-label="종류">
      <button type="button" class="chip" data-k="" aria-pressed="true">전체 {notes.length}</button>
      {noteKinds.map((k) => <button type="button" class="chip" data-k={k} aria-pressed="false">{k} {count(k)}</button>)}
    </div>

    {dates.map((d) => (
      <div class="note-day" id={`d-${d}`}>
        <h2 class="label"><time>{d}</time></h2>
        {rows.filter(({ n }) => n.data.date === d).map(({ n, items, Content }) => (
          <article class="note" id={`n-${n.id}`} data-k={n.data.kind}>
            <header>
              <span class="note-kind">{n.data.kind}</span>
              <h3>{n.data.title}</h3>
              {n.data.seen_at && <span class="note-at">{n.data.link ? <a href={n.data.link}>{n.data.seen_at}</a> : n.data.seen_at}</span>}
            </header>
            <div class="prose"><Content /></div>
            {items.length > 0 && (
              <p class="note-about"><span class="label">이어진 항목 {items.length}</span>{items.map((it) => <a href={it.url}>{it.name}</a>)}</p>
            )}
          </article>
        ))}
      </div>
    ))}

    <div class="note-how">
      <span class="label">기록 남기는 법</span>
      <p><code>src/content/notes/날짜-이름.md</code> 파일 하나를 만들면 됩니다. <code>kind</code>는 본 것 · 메모 · 써 본 예시 가운데 하나이고, <code>about</code>에 이어 붙일 항목을 적습니다.</p>
      <pre><code>{`---
date: "2026-11-02"
kind: "본 것"            # 본 것 · 메모 · 써 본 예시
title: "타입 스케일 비율 비교 릴스"
about: ["formulas/type-scale"]
seen_at: "인스타그램 릴스"  # 어디서 봤나 (선택)
---
본 내용을 한두 줄로 요약.`}</code></pre>
    </div>
  </section>
</Base>

<script>
  const box = document.getElementById('noteKinds')!;
  box.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    const k = b.dataset.k!;
    box.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.note').forEach((n) => (n.hidden = !!k && n.dataset.k !== k));
    document.querySelectorAll<HTMLElement>('.note-day').forEach((d) => (d.hidden = !d.querySelector('.note:not([hidden])')));
  });
</script>
