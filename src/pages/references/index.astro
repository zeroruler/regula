---
import { getCollection } from 'astro:content';
import { refGroups } from '../../content.config';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import RefItem from '../../components/RefItem.astro';
import SeenSync from '../../components/SeenSync.astro';

const references = (await getCollection('references')).sort((a, b) => a.data.order - b.data.order);
const slug = (g: string) => `g-${refGroups.indexOf(g as (typeof refGroups)[number])}`;
---
<Base title="레퍼런스 · Regula" current="references">
  <Fragment slot="sub">
    {refGroups.map((g) => <a href={`#${slug(g)}`}>{g}</a>)}
  </Fragment>

  <PageHead current="references" title="읽고, 보고, 따라 해 볼 것">
    <p>책, 공개 디자인 시스템, 저장소, 커뮤니티를 모았습니다. 제목을 누르면 내 정리와 원문을 이 사이트 안에서 볼 수 있어요. 본 것은 체크해 두세요. 체크 표시는 이 브라우저에만 저장됩니다.</p>
  </PageHead>
  <div class="progress"><span id="refCount">0 / {references.length}</span><div class="meter"><i id="refMeter" style="width:0"></i></div></div>
  <div class="refs">
    {refGroups.map((g) => (
      <div class="refgroup" id={slug(g)}>
        <h3>{g}</h3>
        {references.filter((r) => r.data.group === g).map((r) => <RefItem reference={r} />)}
      </div>
    ))}
  </div>
  <SeenSync />
</Base>
