---
import Base from '../../layouts/Base.astro';
import PatternSection from '../../components/PatternSection.astro';
import PatternSubnav from '../../components/PatternSubnav.astro';
import RowActions from '../../demos/gestures/RowActions.astro';
import { patternsByGroup } from '../../lib/patterns';
import { href } from '../../lib/url';
import Cite from '../../components/Cite.astro';
import { rulesOf, ruleId } from '../../lib/rules';

const groups = await patternsByGroup();
const { group, items } = groups.find((x) => x.group.id === 'gestures')!;

const { rules } = rulesOf('gestures');
---
<Base title="제스처 · UI 패턴 · Regula" current="patterns" description="탭부터 가장자리 스와이프까지 9가지 제스처를 알아채기 어려운 순으로 놓고, 숨은 동작과 대체 수단을 직접 써 보는 페이지">
  <Fragment slot="sub"><PatternSubnav current={['gestures']} /></Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('patterns/')}>§ 3 UI 패턴</a> · 실습</span>
    <h1>숨은 동작은 지름길일 뿐</h1>
    <p>제스처는 아는 사람에게는 빠르고, 모르는 사람에게는 없는 기능입니다. 화면에 보이지 않으니 누군가는 끝내 찾지 못해요. 그래서 제스처마다 같은 일을 하는 보이는 길을 같이 적었습니다.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 대체 수단</span>
      <h2>같은 삭제, 세 가지 길</h2>
      <p>목록 항목을 밀어서, 길게 눌러서, ⋯ 버튼으로 지워 보세요. 그다음 ⋯ 버튼을 숨기면 어떤 사람이 막히는지 봅니다.</p>
    </header>
    <RowActions />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r, i) => <tr id={ruleId('gestures', i)}><td>{r.s}</td><td>{r.rule}</td><td class="src-cell"><Cite text={r.src} /></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <PatternSection group={group} items={items} cols={[{ h: '대체 수단', k: 'fits' }]} />
</Base>
