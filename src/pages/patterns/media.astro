---
import Base from '../../layouts/Base.astro';
import PatternSection from '../../components/PatternSection.astro';
import PatternSubnav from '../../components/PatternSubnav.astro';
import MediaLoss from '../../demos/media/MediaLoss.astro';
import { patternsByGroup } from '../../lib/patterns';
import { href } from '../../lib/url';
import Cite from '../../components/Cite.astro';
import { rulesOf, ruleId } from '../../lib/rules';

const groups = await patternsByGroup();
const { group, items } = groups.find((x) => x.group.id === 'media')!;

const { rules } = rulesOf('media');
---
<Base title="영상과 소리 · UI 패턴 · Regula" current="patterns" description="재생 조절 · 자막 · 실시간 자막 · 음성 해설 · 대본을 언제 쓰고 피하는지, 같은 영상을 소리 없이 보거나 화면 없이 들을 때 무엇을 놓치는지 세어 보는 실습 페이지">
  <Fragment slot="sub"><PatternSubnav current={['media']} /></Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('patterns/')}>§ 3 UI 패턴</a> · 실습</span>
    <h1>소리로만 말한 것, 화면에만 보인 것</h1>
    <p>영상 하나에는 말과 소리, 화면이 함께 들어 있습니다. 듣지 못하는 사람은 말과 소리를, 보지 못하는 사람은 화면에만 나온 것을 놓쳐요. 자막은 앞의 빈칸을, 음성 해설은 뒤의 빈칸을 채우고, 대본은 둘 다 채웁니다.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 놓친 것 세기</span>
      <h2>같은 영상을 두 가지로</h2>
      <p>"3단 우산 접는 법"이라는 짧은 영상을 Regula가 지어 장면마다 받는 정보를 적었습니다. 보는 방식을 바꾸고 자막 · 음성 해설 · 대본을 켜 보세요. 실제 영상은 없고, 무엇을 받는지만 글로 보여 줍니다.</p>
    </header>
    <MediaLoss />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r, i) => <tr id={ruleId('media', i)}><td>{r.s}</td><td>{r.rule}</td><td class="src-cell"><Cite text={r.src} /></td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="note-line">움직이는 화면을 멈추는 법은 <a href={href('principles/motion/')}>움직임</a>, 자동으로 넘어가는 캐러셀은 <a href={href('patterns/layout/')}>화면 구성</a>, 그림의 대체 텍스트는 <a href={href('principles/#f-text-alternative')}>대체 텍스트</a>에 있어요. 기준 원문은 <a href={href('references/wcag-22/')}>WCAG 2.2</a>에서 볼 수 있습니다.</p>
  </section>

  <PatternSection group={group} items={items} cols={[{ h: '누구에게', k: 'fits' }]} />
</Base>
