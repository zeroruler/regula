---
// 시각적 무게: 시소 양쪽 원의 크기·색·결을 바꿔 어느 쪽이 먼저 보이는지(더 무거운지) 본다.
// 무게 계수는 책의 순서(크기와 색이 가장 세고, 결은 그다음)를 흉내 낸 Regula의 어림이다.
const sides = [
  { key: 'l', name: '왼쪽', size: 's', tone: 'dark', grain: 'flat' },
  { key: 'r', name: '오른쪽', size: 'l', tone: 'light', grain: 'flat' },
];
const opts = {
  size: [['s', '작게'], ['m', '중간'], ['l', '크게']],
  tone: [['light', '연하게'], ['dark', '진하게'], ['mark', '채도 높게']],
  grain: [['flat', '매끈'], ['busy', '빗금']],
};
const optName = { size: '크기', tone: '색', grain: '결' } as const;
---
<div class="lab complab" id="cWeight">
  <div class="c-fig">
    <svg viewBox="0 0 320 210" role="img" aria-label="두 원을 올린 시소">
      <defs>
        <pattern id="cwHatchInk" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" class="c-hatch-ink" /></pattern>
        <pattern id="cwHatchPaper" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" class="c-hatch-paper" /></pattern>
      </defs>
      <g class="c-beam-g">
        <line x1="40" y1="160" x2="280" y2="160" class="c-beam" />
        <g class="c-ball" data-side="l"></g>
        <g class="c-ball" data-side="r"></g>
      </g>
      <polygon points="160,162 146,192 174,192" class="c-fulcrum" />
      <line x1="20" y1="193" x2="300" y2="193" class="c-floor" />
    </svg>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 시각적 무게</span>
    <h3>어느 쪽이 먼저 보이나</h3>
    {sides.map((s) => (
      <div class="c-ctrl" data-side={s.key}>
        <span class="label">{s.name}</span>
        {Object.entries(opts).map(([k, list]) => (
          <div class="chips" role="group" aria-label={`${s.name} ${optName[k as keyof typeof optName]}`} data-k={k}>
            {list.map(([v, label]) => (
              <button class="chip" type="button" data-v={v} aria-pressed={String(s[k as 'size' | 'tone' | 'grain'] === v)}>{label}</button>
            ))}
          </div>
        ))}
      </div>
    ))}
    <p class="g-read" aria-live="polite">무게 <span id="cwNum"></span> · <mark id="cwRead"></mark></p>
    <p>기본값은 작고 진한 원과 크고 연한 원 — 속성이 서로 상쇄돼 거의 수평입니다. 한쪽에 빗금이나 채도를 더하면 기울어요.</p>
    <div class="g-ui">
      <span class="label">UI에서</span>
      <p>주 버튼이 커다란 사진에 밀린다면 버튼을 키우기 전에 색(진하게·채도)부터 바꿔 봅니다. 계수(크기 1 · 1.5 · 2.2, 색 1 · 1.8 · 1.7, 빗금 1.3)는 책의 순서를 흉내 낸 Regula의 어림이에요.</p>
    </div>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#cWeight')!;
  const W = { size: { s: 1, m: 1.5, l: 2.2 }, tone: { light: 1, dark: 1.8, mark: 1.7 }, grain: { flat: 1, busy: 1.3 } } as const;
  const R = { s: 16, m: 22, l: 30 } as const;
  type Side = { size: keyof typeof R; tone: keyof typeof W.tone; grain: keyof typeof W.grain };
  const state: Record<'l' | 'r', Side> = { l: { size: 's', tone: 'dark', grain: 'flat' }, r: { size: 'l', tone: 'light', grain: 'flat' } };
  const weight = (s: Side) => W.size[s.size] * W.tone[s.tone] * W.grain[s.grain];

  function ball(s: Side, x: number) {
    const r = R[s.size];
    const cls = `c-shape t-${s.tone}`;
    const hatch = s.grain === 'busy' ? `<circle cx="${x}" cy="${160 - r - 2}" r="${r}" fill="url(#${s.tone === 'dark' ? 'cwHatchPaper' : 'cwHatchInk'})" />` : '';
    return `<circle class="${cls}" cx="${x}" cy="${160 - r - 2}" r="${r}" />${hatch}`;
  }

  function render() {
    const wl = weight(state.l), wr = weight(state.r);
    const diff = (wr - wl) / (wr + wl);
    const deg = Math.max(-12, Math.min(12, diff * 30));
    lab.querySelector('.c-beam-g')!.setAttribute('transform', `rotate(${deg.toFixed(2)} 160 160)`);
    lab.querySelector('[data-side="l"].c-ball')!.innerHTML = ball(state.l, 72);
    lab.querySelector('[data-side="r"].c-ball')!.innerHTML = ball(state.r, 248);
    lab.querySelector('#cwNum')!.textContent = `${wl.toFixed(1)} : ${wr.toFixed(1)}`;
    const ratio = Math.max(wl, wr) / Math.min(wl, wr);
    lab.querySelector('#cwRead')!.textContent = ratio < 1.25 ? '거의 같음 — 어디부터 볼지 흔들림' : wl > wr ? '왼쪽이 먼저 보임' : '오른쪽이 먼저 보임';
  }

  lab.querySelectorAll<HTMLElement>('.c-ctrl').forEach((ctrl) => {
    const side = ctrl.dataset.side as 'l' | 'r';
    ctrl.querySelectorAll<HTMLElement>('.chips').forEach((group) => {
      const k = group.dataset.k as keyof Side;
      group.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
        if (!btn) return;
        group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        (state[side] as Record<string, string>)[k] = btn.dataset.v!;
        render();
      });
    });
  });
  render();
</script>
