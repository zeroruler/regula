---
// 같은 다섯 목적지를 하단 탭 바(늘 보임)와 햄버거 메뉴(숨김)로 두고, 목표 화면까지 몇 번 눌렀는지 센다.
const dests = ['홈', '검색', '저장', '알림', '설정'];
---
<div class="lab navlab" id="navHidden" data-dests={JSON.stringify(dests)}>
  <div class="phone-wrap">
    <div class="phone m-bar" id="nhPhone">
      <div class="ph-top"><button type="button" class="ph-menu" aria-label="메뉴 열기">≡</button><b id="nhTitle">홈</b></div>
      <div class="ph-body"><div class="ln d"></div><div class="ln"></div><div class="ln" style="width:72%"></div><div class="ln"></div><div class="ln" style="width:55%"></div></div>
      <nav class="ph-bar" aria-label="하단 탭 바">
        {dests.map((d) => <button type="button" data-d={d}><i></i>{d}</button>)}
      </nav>
      <div class="ph-drawer" hidden>
        <button type="button" class="ph-close" aria-label="메뉴 닫기">✕</button>
        {dests.map((d) => <button type="button" data-d={d}>{d}</button>)}
      </div>
    </div>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 드러난 메뉴, 숨은 메뉴</span>
    <h3>목표까지 몇 번 눌러야 할까</h3>
    <div class="chips" id="nhChips">
      <button class="chip" type="button" data-m="bar" aria-pressed="true">하단 탭 바</button>
      <button class="chip" type="button" data-m="drawer" aria-pressed="false">햄버거 메뉴</button>
    </div>
    <p class="nh-goal">목표: <b id="nhGoal"></b> 화면으로 가기</p>
    <p class="g-read">누른 횟수: <mark id="nhRead"></mark></p>
    <dl class="gridread">
      <dt>탭 바 평균</dt><dd id="nhAvgBar">—</dd>
      <dt>햄버거 평균</dt><dd id="nhAvgDrawer">—</dd>
    </dl>
    <p>폰 화면 안을 눌러 목표로 가 보세요. 도착하면 다음 목표가 나옵니다. 숨은 메뉴는 매번 한 번을 더 누르게 하고, 무엇이 있는지 열기 전엔 보이지 않습니다.</p>
    <div class="g-ui">
      <span class="label">규칙</span>
      <p>자주 가는 최상위 목적지는 숨기지 않는다. 다섯 곳 안쪽이면 하단 탭 바로 늘 보이게, 그보다 많고 드물게 가는 곳만 메뉴에 넣는다.</p>
    </div>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#navHidden')!;
  const dests: string[] = JSON.parse(lab.dataset.dests!);
  const phone = lab.querySelector<HTMLElement>('#nhPhone')!;
  const drawer = phone.querySelector<HTMLElement>('.ph-drawer')!;
  let mode = 'bar', here = '홈', goal = '저장', taps = 0;
  const log: Record<string, number[]> = { bar: [], drawer: [] };

  const avg = (xs: number[]) => (xs.length ? `${(xs.reduce((a, b) => a + b, 0) / xs.length).toFixed(1)}번 (${xs.length}회)` : '—');
  function render() {
    phone.className = `phone m-${mode}`; // .bar는 계산 도구의 막대 클래스라 m- 접두어
    phone.querySelector('#nhTitle')!.textContent = here;
    phone.querySelectorAll<HTMLElement>('[data-d]').forEach((b) => b.dataset.d === here ? b.setAttribute('aria-current', 'page') : b.removeAttribute('aria-current'));
    lab.querySelector('#nhGoal')!.textContent = goal;
    lab.querySelector('#nhRead')!.textContent = `${taps}번`;
    lab.querySelector('#nhAvgBar')!.textContent = avg(log.bar);
    lab.querySelector('#nhAvgDrawer')!.textContent = avg(log.drawer);
  }
  function nextGoal() {
    const options = dests.filter((d) => d !== here);
    goal = options[Math.floor(Math.random() * options.length)];
    taps = 0;
  }
  phone.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (!t.closest('button')) return;
    taps++;
    if (t.closest('.ph-menu')) drawer.hidden = false;
    else if (t.closest('.ph-close')) drawer.hidden = true;
    const d = t.closest<HTMLElement>('[data-d]');
    if (d) {
      here = d.dataset.d!;
      drawer.hidden = true;
      if (here === goal) { log[mode].push(taps); render(); setTimeout(() => { nextGoal(); render(); }, 700); return; }
    }
    render();
  });
  lab.querySelector('#nhChips')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    mode = b.dataset.m!;
    lab.querySelectorAll('#nhChips button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    drawer.hidden = true;
    nextGoal();
    render();
  });
  render();
</script>
