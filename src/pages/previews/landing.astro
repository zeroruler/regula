---
// 랜딩 페이지 양식 미리보기. ?system=<디자인 시스템>&state=<default|twoprimary|stock> 로 토큰과 상태를 바꾼다.
// 사이트 레이아웃 없이 단독 화면으로 열린다 (양식 상세 페이지의 iframe 안). 토큰 입히기는 로그인 미리보기와 같다.
// 서비스 이름 "줄자"와 문구 · 가격은 지어낸 예시. 그림은 흑백 와이어프레임.
// 높이를 vh로 잡지 않는다 — 상세 페이지가 iframe 높이를 내용에 맞춰 늘리므로 vh를 쓰면 끝없이 커진다.
import { loadThemes } from '../../lib/themes';

const themes = await loadThemes();
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>줄자 — 화면 간격을 재는 도구 · 랜딩 페이지 미리보기 · Regula</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/complete/WantedSansVariable.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Noto+Serif+KR:wght@600&family=Archivo+Black&family=Black+Han+Sans&family=Gothic+A1:wght@400;700&family=Hahmlet:wght@700&family=IBM+Plex+Sans+KR:wght@400;600&display=swap">
<style>
:root{
  --stroke:1px; --button-shadow:none; --card-shadow:none;
  --title-weight:700; --title-tracking:-0.02em;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.6;display:grid;grid-template-columns:minmax(0,1fr);word-break:keep-all;overflow-wrap:anywhere}
.wrap{width:100%;max-width:960px;margin:0 auto;padding:0 20px;display:grid;grid-template-columns:minmax(0,1fr)}
h1,h2,h3{font-family:var(--display);font-weight:var(--title-weight);letter-spacing:var(--title-tracking);margin:0}
p{margin:0}
a{color:var(--ink)}
a:focus-visible,.btn:focus-visible{outline:2px solid var(--key);outline-offset:2px}

/* 머리글 */
.top{display:flex;align-items:center;gap:16px;min-height:60px;border-bottom:var(--stroke) solid var(--card-border)}
.logo{font-family:var(--display);font-weight:var(--title-weight);font-size:19px;text-decoration:none;color:var(--ink)}
.top nav{margin-left:auto;display:flex;gap:16px;font-size:14px}
.top nav a{text-decoration:none;color:var(--ink2)}
.top nav a:last-child{color:var(--ink);text-decoration:underline;text-underline-offset:.2em}

/* 첫 화면 */
.hero{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;padding:48px 0 0}
@media (min-width:760px){ .hero{grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;padding-top:64px} }
.hero h1{font-size:clamp(30px,5vw,44px);line-height:1.15}
.hero .sub{margin-top:14px;font-size:17px;color:var(--ink2);max-width:28em}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:24px}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:var(--radius);font:inherit;font-weight:600;font-size:16px;text-decoration:none;box-shadow:var(--button-shadow);cursor:pointer}
.primary{background:var(--key);color:var(--on-key);border:var(--stroke) solid var(--key)}
.secondary{background:var(--surface);color:var(--ink);border:var(--stroke) solid var(--border)}
.textlink{color:var(--ink);text-decoration:underline;text-underline-offset:.2em;font-size:15px}
.know{margin-top:14px;font-size:13px;color:var(--ink3)}
.shot{margin:0}
.shot svg{display:block;width:100%;height:auto;background:var(--surface);border:var(--stroke) solid var(--card-border);border-radius:var(--card-radius);box-shadow:var(--card-shadow);color:var(--ink)}
.shot figcaption{margin-top:8px;font-size:13px;color:var(--ink3)}
/* 다음 구획이 첫 화면 아래에 걸쳐 보이게 여백을 줄여 둔다 (거짓 바닥 피하기) */
.peek{margin-top:40px}

section{padding:40px 0;border-top:var(--stroke) solid var(--card-border)}
section > h2{font-size:24px;line-height:1.3;margin-bottom:20px}
.tasks{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;margin:0;padding:0;list-style:none}
@media (min-width:640px){ .tasks{grid-template-columns:repeat(3,minmax(0,1fr))} }
.tasks h3{font-size:17px;margin-bottom:4px}
.tasks p{font-size:15px;color:var(--ink2)}
.example{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}
@media (min-width:640px){ .example{grid-template-columns:repeat(2,minmax(0,1fr))} }
dl.facts{display:grid;grid-template-columns:minmax(0,1fr);gap:0;margin:0}
.facts div{display:grid;grid-template-columns:7em minmax(0,1fr);gap:12px;padding:12px 0;border-bottom:var(--stroke) solid var(--card-border)}
.facts dt{color:var(--ink2);font-size:14px}
.facts dd{margin:0}
blockquote{margin:0;padding-left:16px;border-left:3px solid var(--border);font-size:17px}
.who{margin-top:8px;font-size:14px;color:var(--ink3)}
.end{text-align:left}
.end p{color:var(--ink2);margin-bottom:20px}
footer{padding:24px 0 40px;border-top:var(--stroke) solid var(--card-border);font-size:13px;color:var(--ink3);display:flex;flex-wrap:wrap;gap:8px 20px}
footer a{color:var(--ink2)}

/* 상태: 주 버튼 둘 — 보조 링크가 두 번째 주 버튼이 된다 */
html[data-state=twoprimary] .alt-link{display:none}
html:not([data-state=twoprimary]) .alt-btn{display:none}
/* 상태: 꾸밈용 그림 — 실제 화면 대신 아무 데나 쓸 수 있는 사진 자리 */
html[data-state=stock] .real{display:none}
html:not([data-state=stock]) .stock{display:none}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <a class="logo" href="#">줄자</a>
    <nav aria-label="주 메뉴"><a href="#how">하는 일</a><a href="#price">가격</a><a href="#">로그인</a></nav>
  </header>

  <main>
    <div class="hero">
      <div>
        <h1>화면 사이 간격을 클릭 한 번으로 잰다</h1>
        <p class="sub">브라우저에서 두 요소를 누르면 둘 사이 거리와 8pt 눈금에서 벗어난 값을 바로 보여 줘요.</p>
        <div class="actions">
          <a class="btn primary" href="#">무료로 시작하기</a>
          <a class="textlink alt-link" href="#example">예시 화면 보기</a>
          <a class="btn primary alt-btn" href="#example">예시 화면 보기</a>
        </div>
        <p class="know">카드 등록 없음 · 설치 1분 · 크롬과 파이어폭스</p>
      </div>
      <figure class="shot real">
        <svg viewBox="0 0 400 260" role="img" aria-label="줄자 화면. 웹 페이지 위 두 상자 사이에 24px이라는 측정선이 그려져 있고, 오른쪽 패널에 8pt 눈금에서 벗어난 값 2개가 목록으로 나온다.">
          <rect x="0" y="0" width="400" height="22" fill="currentColor" fill-opacity=".06"/>
          <circle cx="12" cy="11" r="3" fill="currentColor" fill-opacity=".3"/><circle cx="22" cy="11" r="3" fill="currentColor" fill-opacity=".3"/><circle cx="32" cy="11" r="3" fill="currentColor" fill-opacity=".3"/>
          <rect x="24" y="44" width="210" height="58" rx="4" fill="none" stroke="currentColor" stroke-opacity=".6"/>
          <rect x="24" y="126" width="210" height="58" rx="4" fill="none" stroke="currentColor" stroke-opacity=".6"/>
          <line x1="129" y1="104" x2="129" y2="124" stroke="currentColor" stroke-width="1.5"/>
          <line x1="122" y1="104" x2="136" y2="104" stroke="currentColor"/><line x1="122" y1="124" x2="136" y2="124" stroke="currentColor"/>
          <rect x="140" y="106" width="34" height="16" rx="3" fill="currentColor"/>
          <text x="157" y="118" text-anchor="middle" font-size="10" style="fill:var(--surface)" font-family="ui-monospace,monospace">24px</text>
          <line x1="258" y1="22" x2="258" y2="260" stroke="currentColor" stroke-opacity=".2"/>
          <text x="272" y="48" font-size="10" fill="currentColor" fill-opacity=".7">8pt에서 벗어남</text>
          <g fill="currentColor" fill-opacity=".45"><rect x="272" y="62" width="100" height="6" rx="1"/><rect x="272" y="80" width="84" height="6" rx="1"/></g>
          <text x="376" y="68" font-size="9" fill="currentColor" font-family="ui-monospace,monospace" text-anchor="end">13</text>
          <text x="376" y="86" font-size="9" fill="currentColor" font-family="ui-monospace,monospace" text-anchor="end">30</text>
          <g fill="currentColor" fill-opacity=".18"><rect x="24" y="206" width="160" height="6" rx="1"/><rect x="24" y="222" width="120" height="6" rx="1"/></g>
        </svg>
        <figcaption>실제 측정 화면 (와이어프레임)</figcaption>
      </figure>
      <figure class="shot stock">
        <svg viewBox="0 0 400 260" role="img" aria-label="웃으며 노트북을 보는 사람들 사진 자리. 서비스와 관계없는 꾸밈용 그림.">
          <rect x="1" y="1" width="398" height="258" fill="none" stroke="currentColor" stroke-opacity=".4"/>
          <line x1="1" y1="1" x2="399" y2="259" stroke="currentColor" stroke-opacity=".25"/><line x1="399" y1="1" x2="1" y2="259" stroke="currentColor" stroke-opacity=".25"/>
          <g fill="none" stroke="currentColor" stroke-opacity=".6"><circle cx="150" cy="100" r="22"/><path d="M110 170q40-50 80 0"/><circle cx="250" cy="100" r="22"/><path d="M210 170q40-50 80 0"/></g>
          <text x="200" y="230" text-anchor="middle" font-size="12" fill="currentColor" fill-opacity=".7">"함께 일하는 사람들" 스톡 사진</text>
        </svg>
        <figcaption>어느 서비스에나 붙일 수 있는 사진 — 무엇을 하는지 말해 주지 않는다</figcaption>
      </figure>
    </div>

    <section class="peek" id="how" aria-labelledby="h-how">
      <h2 id="h-how">줄자로 하는 일</h2>
      <ul class="tasks">
        <li><h3>간격 재기</h3><p>두 요소를 차례로 누르면 가로 · 세로 거리를 px로 보여 줘요.</p></li>
        <li><h3>눈금 확인</h3><p>8pt 눈금에서 벗어난 값을 한 목록으로 모아요.</p></li>
        <li><h3>공유하기</h3><p>잰 화면을 링크 하나로 동료에게 보내요.</p></li>
      </ul>
    </section>

    <section id="example" aria-labelledby="h-ex">
      <h2 id="h-ex">실제로 재 본 화면</h2>
      <div class="example">
        <figure class="shot">
          <svg viewBox="0 0 300 160" role="img" aria-label="로그인 카드를 잰 결과. 입력 칸 사이 간격 16px, 버튼 위 간격 24px.">
            <rect x="70" y="16" width="160" height="128" rx="6" fill="none" stroke="currentColor" stroke-opacity=".6"/>
            <rect x="86" y="34" width="128" height="20" rx="3" fill="none" stroke="currentColor" stroke-opacity=".5"/>
            <rect x="86" y="70" width="128" height="20" rx="3" fill="none" stroke="currentColor" stroke-opacity=".5"/>
            <rect x="86" y="114" width="128" height="20" rx="3" fill="currentColor" fill-opacity=".7"/>
            <line x1="240" y1="54" x2="240" y2="70" stroke="currentColor"/><text x="246" y="66" font-size="9" fill="currentColor" font-family="ui-monospace,monospace">16</text>
            <line x1="240" y1="90" x2="240" y2="114" stroke="currentColor"/><text x="246" y="106" font-size="9" fill="currentColor" font-family="ui-monospace,monospace">24</text>
          </svg>
          <figcaption>로그인 카드 — 모두 8의 배수</figcaption>
        </figure>
        <figure class="shot">
          <svg viewBox="0 0 300 160" role="img" aria-label="목록 화면을 잰 결과. 행 사이 간격 13px로 8pt 눈금에서 벗어남 표시.">
            <g fill="none" stroke="currentColor" stroke-opacity=".5"><rect x="40" y="20" width="220" height="28" rx="3"/><rect x="40" y="61" width="220" height="28" rx="3"/><rect x="40" y="102" width="220" height="28" rx="3"/></g>
            <line x1="270" y1="48" x2="270" y2="61" stroke="currentColor" stroke-width="1.5"/>
            <text x="276" y="58" font-size="9" fill="currentColor" font-family="ui-monospace,monospace">13</text>
            <text x="150" y="150" text-anchor="middle" font-size="9" fill="currentColor" fill-opacity=".7">13px — 8pt에서 벗어남</text>
          </svg>
          <figcaption>목록 화면 — 벗어난 값 1개</figcaption>
        </figure>
      </div>
    </section>

    <section id="price" aria-labelledby="h-price">
      <h2 id="h-price">시작하기 전에</h2>
      <dl class="facts">
        <div><dt>가격</dt><dd>개인은 무료. 팀은 한 사람에 월 5,000원(부가세 포함)</dd></div>
        <div><dt>걸리는 시간</dt><dd>확장 프로그램 설치 1분</dd></div>
        <div><dt>필요한 것</dt><dd>크롬 또는 파이어폭스, 이메일 주소</dd></div>
        <div><dt>그만두기</dt><dd>설정에서 바로 해지, 위약금 없음</dd></div>
      </dl>
    </section>

    <section aria-labelledby="h-voice">
      <h2 id="h-voice">쓰는 사람</h2>
      <blockquote><p>"리뷰 때 간격 얘기가 숫자로 끝나서 말다툼이 줄었어요."</p></blockquote>
      <p class="who">— 예시 후기 자리. 실제 서비스에서는 실제 이름 · 소속과 허락받은 후기만 둔다</p>
    </section>

    <section class="end" aria-labelledby="h-end">
      <h2 id="h-end">지금 화면부터 재 보세요</h2>
      <p>카드 등록 없이 개인 계정으로 시작해요.</p>
      <a class="btn primary" href="#">무료로 시작하기</a>
    </section>
  </main>

  <footer>
    <span>줄자 (예시 서비스)</span><a href="#">회사 소개</a><a href="#">개인정보 처리방침</a><a href="#">문의</a>
  </footer>
</div>

<script is:inline define:vars={{ themes }}>
  if (window.self !== window.top) document.documentElement.classList.add('embedded');
  const params = new URLSearchParams(location.search);
  const theme = themes.find((t) => t.id === params.get('system')) ?? themes[0];
  for (const [role, value] of Object.entries(theme.vars)) if (value) document.documentElement.style.setProperty(`--${role}`, value);
  const state = params.get('state');
  if (['twoprimary', 'stock'].includes(state)) document.documentElement.dataset.state = state;
</script>
</body>
</html>
