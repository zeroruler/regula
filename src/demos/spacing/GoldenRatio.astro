---
// 정사각형을 떼어낸 뒤 남는 사각형의 비율을 비교하는 실험 (황금비만 자기닮음)
const ratios = [
  { r: 1.414, n: '√2 · A4 용지', note: 'A4는 반으로 접어도 같은 비율이 남도록 만든 종이예요. 하지만 정사각형을 떼어내면 2.414라는 전혀 다른 비율이 남습니다.' },
  { r: 1.5, n: '3:2 · 사진', note: '35mm 필름과 많은 카메라 센서의 비율. 정사각형을 떼면 2:1의 길쭉한 사각형이 남아요.' },
  { r: 1.618, n: 'φ · 황금비', note: '정사각형을 떼어내도 남은 사각형이 처음과 같은 비율입니다. 이 성질 때문에 끝없이 나선을 그릴 수 있어요. 레이아웃에서는 본문:사이드바 = 1.618:1 같은 식으로 씁니다.' },
  { r: 1.778, n: '16:9 · 화면', note: '영상과 모니터의 표준 비율. 정사각형을 떼면 1.286이 남아 자기닮음이 깨집니다.' },
];
const initial = 2;
---
<div class="lab" id="goldenLab" data-ratios={JSON.stringify(ratios)} data-initial={initial}>
  <svg id="golden" viewBox="0 0 480 300" role="img" aria-label="비율별 사각형 분할 도해"></svg>
  <div class="lab-side">
    <span class="label">실험 · 정사각형을 떼어내면</span>
    <div class="chips" id="ratioChips">
      {ratios.map((x, i) => <button class="chip" type="button" data-i={i} aria-pressed={String(i === initial)}>{x.r} {x.n.split(' · ')[1]}</button>)}
    </div>
    <div class="readout" id="ratioReadout">1.618<small>남은 사각형의 비율</small></div>
    <p id="ratioNote"></p>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#goldenLab')!;
  const ratios: { r: number; note: string }[] = JSON.parse(lab.dataset.ratios!);
  let cur = +lab.dataset.initial!;
  const chips = lab.querySelector('#ratioChips')!;
  chips.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    cur = +b.dataset.i!;
    draw();
  });
  function draw() {
    chips.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-pressed', String(i === cur)));
    const R = ratios[cur].r, H = 280, W = Math.min(470, H * R), h = W / R;
    let x = (480 - W) / 2, y = (300 - h) / 2, w = W, hh = h;
    let out = `<rect x="${x}" y="${y}" width="${w}" height="${hh}" fill="none" stroke="var(--ink)" stroke-width="1.5"/>`;
    let path = '';
    for (let i = 0; i < 9 && w > 2 && hh > 2; i++) {
      const d = i % 4;
      let s: number, sx: number, sy: number, a: number[], b: number[];
      if (d === 0) { s = hh; if (s > w) break; sx = x; sy = y; a = [sx, sy + s]; b = [sx + s, sy]; x += s; w -= s; }
      else if (d === 1) { s = w; if (s > hh) break; sx = x; sy = y; a = [sx, sy]; b = [sx + s, sy + s]; y += s; hh -= s; }
      else if (d === 2) { s = hh; if (s > w) break; sx = x + w - s; sy = y; a = [sx + s, sy]; b = [sx, sy + s]; w -= s; }
      else { s = w; if (s > hh) break; sx = x; sy = y + hh - s; a = [sx + s, sy + s]; b = [sx, sy]; hh -= s; }
      const fill = i === 0 ? 'color-mix(in srgb,var(--mark) 45%,transparent)' : 'none';
      out += `<rect x="${sx}" y="${sy}" width="${s}" height="${s}" fill="${fill}" stroke="var(--ink-3)" stroke-width="1"/>`;
      path += (i === 0 ? `M${a[0]} ${a[1]}` : '') + ` A${s} ${s} 0 0 1 ${b[0]} ${b[1]}`;
    }
    out += `<path d="${path}" fill="none" stroke="var(--ink)" stroke-width="2"/>`;
    out += `<text x="${(480 - W) / 2}" y="${(300 - h) / 2 - 6}" font-family="IBM Plex Mono,monospace" font-size="11" fill="var(--ink-3)">1 : ${R}</text>`;
    lab.querySelector('#golden')!.innerHTML = out;
    const rem = 1 / (R - 1);
    lab.querySelector('#ratioReadout')!.innerHTML = `${rem.toFixed(3)}<small>정사각형을 떼고 남은 사각형의 비율</small>`;
    lab.querySelector('#ratioNote')!.textContent = ratios[cur].note;
  }
  draw();
</script>
