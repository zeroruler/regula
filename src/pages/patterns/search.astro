---
import Base from '../../layouts/Base.astro';
import PatternSection from '../../components/PatternSection.astro';
import PatternSubnav from '../../components/PatternSubnav.astro';
import Filter from '../../demos/search/Filter.astro';
import { patternsByGroup } from '../../lib/patterns';
import { href } from '../../lib/url';
import Cite from '../../components/Cite.astro';

const groups = await patternsByGroup();
const { group, items } = groups.find((x) => x.group.id === 'search')!;

// 찾기와 거르기 규칙. 원문을 읽고 확인한 것만 적는다(docs/source-check.md 10차).
const rules = [
  { s: '검색창', rule: '링크가 아니라 바로 칠 수 있는 입력칸으로, 흔한 검색어가 다 보일 만큼 넓게 둔다', src: 'Jakob Nielsen, 「Search: Visible and Simple」 (NN/g, 2001)' },
  { s: '돋보기', rule: '돋보기는 검색으로 알아보지만, 입력칸 없이 아이콘만 두면 검색을 찾기 어렵다', src: 'Katie Sherwin, 「The Magnifying-Glass Icon in Search Design」 (NN/g, 2014)' },
  { s: '검색 범위', rule: 'placeholder로 무엇을 찾을 수 있는지 알리고, 범위는 넓게 시작해 사용자가 좁히게 한다', src: 'Apple HIG Search fields' },
  { s: '검색 제안', rule: '끝 글자를 채워 주는 제안이면 덧붙인 글자를, 검색어가 가운데 들어가는 제안이면 사용자가 친 글자를 강조한다', src: 'Kate Moran, 「Site Search Suggestions」 (NN/g, 2018)' },
  { s: '적용 시점', rule: '둘러보는 사용자에겐 바로 적용, 조건이 분명하거나 사이트가 느리면 모아서 적용. 고르는 도중 화면을 위로 튕기지 않는다', src: 'Katie Sherwin, 「User Intent Affects Filter Design」 (NN/g, 2016)' },
  { s: '좁은 화면', rule: '패싯은 결과 위에 뜨는 판(tray)에 두어 결과가 뒤에서 바뀌는 게 보이게 하고, 전체 결과 수를 늘 보여 준다', src: 'Kathryn Whitenton, 「Mobile Faceted Search with a Tray」 (NN/g, 2015)' },
  { s: '필터 이름', rule: '카테고리와 값은 알맞고, 예측할 수 있고, 내부 용어 없이, 중요한 것부터', src: 'Kate Moran, 「Helpful Filter Categories and Values for Better UX」 (NN/g, 2018)' },
  { s: '결과 없음', rule: '결과가 없다고 분명히 말하고, 다음에 할 일을 주고, 사용자를 탓하지 않는다', src: 'Kathryn Whitenton, 「3 Guidelines for Search Engine "No Results" Pages」 (NN/g, 2014)' },
  { s: '접근성', rule: '결과 수 변화는 포커스를 옮기지 않고 화면 낭독기에 알린다(role="status"). 정렬된 열 머리에는 aria-sort', src: 'WCAG 2.2 4.1.3 Status Messages (AA) · W3C WAI-ARIA APG Sortable Table' },
];
---
<Base title="찾기와 거르기 · UI 패턴 · Regula" current="patterns" description="검색창 · 최근 검색어 · 검색 제안 · 정렬 · 필터 칩 · 적용된 필터 · 패싯 필터를 언제 쓰고 피하는지, 필터를 바로 적용할지 모아서 적용할지 직접 비교하는 실습 페이지">
  <Fragment slot="sub"><PatternSubnav current={['search']} /></Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('patterns/')}>§ 3 UI 패턴</a> · 실습</span>
    <h1>아는 사람은 치고, 모르는 사람은 좁힌다</h1>
    <p>찾을 것의 이름을 아는 사람에게는 검색창 하나면 되지만, 아직 무엇을 원하는지 모르는 사람은 조건을 걸어 가며 무엇이 있는지부터 알아 갑니다. 같은 상품 목록에도 두 길을 다 열어 두고, 어느 쪽이든 지금 몇 개가 남았는지 보여 주세요.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 거르기</span>
      <h2>조건 셋을 거는 동안 몇 번 기다리나</h2>
      <p>적용 방식과 응답 속도를 바꾼 뒤 색 · 크기 · 배송 조건을 셋쯤 걸어 보세요. 같은 결과에 닿기까지 화면이 몇 번 바뀌고 얼마나 기다리는지가 달라집니다.</p>
    </header>
    <Filter />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r) => <tr><td>{r.s}</td><td>{r.rule}</td><td class="src-cell"><Cite text={r.src} /></td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="note-line">결과가 없는 화면은 <a href={href('patterns/states/')}>빈 상태</a>, 고르는 값이 정해진 입력칸(콤보박스)은 <a href={href('patterns/forms/')}>입력</a>, 목록 · 표 · 카드는 <a href={href('patterns/layout/')}>화면 구성</a>에 있어요.</p>
  </section>

  <PatternSection group={group} items={items} cols={[{ h: '알맞은 양', k: 'fits' }]} />
</Base>
