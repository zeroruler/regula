---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FormulaRow from '../components/FormulaRow.astro';
import { topics } from '../lib/site';
import { href } from '../lib/url';

const formulas = (await getCollection('formulas')).sort((a, b) => a.data.order - b.data.order);
const refTitles = Object.fromEntries((await getCollection('references')).map((r) => [r.id, r.data.title]));
const anchor = (i: number) => `t-${i}`;
---
<Base title="원리와 공식 · Regula" current="principles">
  <Fragment slot="sub">
    {topics.map((t, i) => <a href={t.path ? href(t.path) : `#${anchor(i)}`}>{t.name}{t.path && ' →'}</a>)}
  </Fragment>

  <PageHead current="principles" title="숫자로 남길 수 있는 것은 숫자로">
    <p>비율, 간격, 글자 크기, 대비처럼 측정할 수 있는 규칙을 주제별로 모읍니다. 각 항목에 확인한 출처를 붙여 둡니다. 실습이 있는 주제는 따로 페이지가 있어요.</p>
  </PageHead>

  {topics.map((t, i) => (
    <section id={anchor(i)} class="topic">
      <header class="topichead">
        <h2>{t.name}</h2>
        {t.path && <a class="open" href={href(t.path)}>실습 페이지로 →</a>}
      </header>
      <div class="formulas">
        {formulas.filter((f) => f.data.topic === t.name).map((f) => <FormulaRow formula={f} refTitles={refTitles} />)}
      </div>
    </section>
  ))}
</Base>
