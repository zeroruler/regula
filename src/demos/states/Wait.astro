---
// 걸리는 시간을 정하고 로딩 표시를 골라 직접 불러와 본다. 시간대별 권장(Nielsen의 0.1 · 1 · 10초)과 고른 것을 견준다.
const steps = [0.3, 0.6, 1, 2, 3, 5, 8, 12, 20];
const kinds = [
  { k: 'none', n: '표시 없음' },
  { k: 'spinner', n: '스피너' },
  { k: 'skeleton', n: '스켈레톤' },
  { k: 'progress', n: '진행 막대' },
];
---
<div class="lab stlab" id="waitLab" data-steps={JSON.stringify(steps)}>
  <div class="wl-frame">
    <div class="wl-head"><b>받은 메시지</b><span class="mono" id="wlClock">0.0초</span></div>
    <div class="wl-list" id="wlList" aria-live="polite"></div>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 기다리는 시간과 로딩 표시</span>
    <h3>얼마나 걸리면 무엇을 보여 줄까</h3>
    <div class="row">
      <label class="label" for="wlDur">걸리는 시간</label>
      <input type="range" id="wlDur" min="0" max={steps.length - 1} value="4" style="flex:1">
      <span class="mono" id="wlDurVal"></span>
    </div>
    <div class="chips" id="wlKinds">
      {kinds.map((k, i) => <button class="chip" type="button" data-k={k.k} aria-pressed={String(i === 1)}>{k.n}</button>)}
    </div>
    <div class="row"><button class="btn-x fill live" type="button" id="wlGo">불러오기</button></div>
    <p class="g-read">판정: <mark id="wlRead"></mark></p>
    <p id="wlNote"></p>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#waitLab')!;
  const steps: number[] = JSON.parse(lab.dataset.steps!);
  const list = lab.querySelector<HTMLElement>('#wlList')!;
  const dur = lab.querySelector<HTMLInputElement>('#wlDur')!;
  const clock = lab.querySelector('#wlClock')!;
  let kind = 'spinner', timer = 0;

  const best = (d: number) => (d < 1 ? 'none' : d < 2 ? 'spinner' : d <= 10 ? 'skeleton' : 'progress');
  const names: Record<string, string> = { none: '표시 없음', spinner: '스피너', skeleton: '스켈레톤', progress: '진행 막대' };
  const notes: Record<string, string> = {
    none: '1초 안에 끝나면 표시를 띄우지 않는 게 낫습니다. 스피너가 번쩍 나타났다 사라지면 오히려 거슬려요.',
    spinner: '1–2초쯤이면 무언가 돌아가고 있다는 신호 하나로 충분합니다. 생각의 흐름이 끊기지 않는 한계가 1초 언저리예요.',
    skeleton: '몇 초 걸리는 첫 로드는 내용이 들어설 자리를 미리 보여 주는 스켈레톤이 좋습니다. 다 불러와도 화면이 튀지 않아요.',
    progress: '10초를 넘으면 사람들은 기다릴지 떠날지 고민합니다. 얼마나 남았는지 보여 줘야 해요.',
  };
  const done = () => Array.from({ length: 4 }, (_, i) => `<div class="wl-item"><i></i><div><b>보낸 사람 ${i + 1}</b><span>메시지 미리보기 한 줄</span></div></div>`).join('');

  function judge() {
    const d = steps[+dur.value], b = best(d);
    lab.querySelector('#wlDurVal')!.textContent = `${d}초`;
    lab.querySelector('#wlRead')!.textContent = kind === b ? `알맞음 — ${names[b]}` : `${names[b]} 권장`;
    lab.querySelector('#wlNote')!.textContent = notes[b];
  }
  function load() {
    cancelAnimationFrame(timer);
    const d = steps[+dur.value] * 1000, t0 = performance.now(), k = kind; // 불러오는 도중 표시를 바꿔도 이번 로드는 처음 고른 표시로
    list.setAttribute('aria-busy', 'true');
    list.innerHTML =
      k === 'spinner' ? '<div class="wl-center"><i class="spin-l"></i><span class="vh">불러오는 중</span></div>'
      : k === 'skeleton' ? Array.from({ length: 4 }, () => '<div class="wl-item sk"><i></i><div><b></b><span></span></div></div>').join('')
      : k === 'progress' ? '<div class="wl-center"><div class="pbm wide"><i></i></div><span class="mono" id="wlPct"></span></div>'
      : '';
    const tick = (now: number) => {
      const t = now - t0;
      clock.textContent = `${(Math.min(t, d) / 1000).toFixed(1)}초`;
      if (k === 'progress') {
        const p = Math.min(1, t / d);
        list.querySelector<HTMLElement>('.pbm i')!.style.width = `${p * 100}%`;
        list.querySelector('#wlPct')!.textContent = `${Math.round(p * 100)}% · 약 ${Math.max(0, Math.ceil((d - t) / 1000))}초 남음`;
      }
      if (t < d) { timer = requestAnimationFrame(tick); return; }
      list.removeAttribute('aria-busy');
      list.innerHTML = done();
    };
    timer = requestAnimationFrame(tick);
  }
  lab.querySelector('#wlKinds')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    kind = b.dataset.k!;
    lab.querySelectorAll('#wlKinds button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    judge();
  });
  dur.addEventListener('input', judge);
  lab.querySelector('#wlGo')!.addEventListener('click', load);
  list.innerHTML = done();
  judge();
</script>
