---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { loadTemplate } from '../../lib/templates';
import { href } from '../../lib/url';

const templates = (await getCollection('templates')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="페이지 양식 · Regula" current="templates">
  <Fragment slot="sub">
    {templates.map((t) => <a href={href(`templates/${t.id}/`)}>{t.data.name}</a>)}
  </Fragment>

  <PageHead current="templates" title="다시 쓸 수 있는 디자인 양식">
    <p>직접 만든 디자인 시스템과 페이지별 양식을 등록하는 곳입니다. 이름을 누르면 시그니처, 미리보기, 실제 토큰 전체를 볼 수 있어요.</p>
  </PageHead>
  <div class="tplrows">
    {templates.map((t) => {
      const { strip } = loadTemplate(t);
      return (
        <a class="tplrow" href={href(`templates/${t.id}/`)}>
          <div class="strip" aria-hidden="true">{strip.map((s) => <i style={`background:${s.value}`}></i>)}</div>
          <div>
            <span class="label">No.{t.data.order} · {t.data.kind}{t.data.used_in.length > 0 && ` · ${t.data.used_in.join(', ')}`}</span>
            <h3>{t.data.name}</h3>
            <p>{t.data.concept}</p>
            <div class="sig">{t.data.signatures.map((x) => x.split(' — ')[0]).join(' · ')}</div>
          </div>
        </a>
      );
    })}
  </div>
  <div class="tpl todo">
    <span class="label">채워 나갈 양식</span>
    <div class="slots">
      <div class="slot"><span>랜딩 페이지</span><span>비어 있음</span></div>
      <div class="slot"><span>로그인 · 회원가입</span><span>비어 있음</span></div>
      <div class="slot"><span>설정 화면</span><span>비어 있음</span></div>
      <div class="slot"><span>대시보드</span><span>비어 있음</span></div>
      <div class="slot"><span>글 · 블로그 본문</span><span>비어 있음</span></div>
    </div>
  </div>
</Base>
