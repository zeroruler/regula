---
// 실습: 같은 짧은 영상(Regula가 지은 대본)을 소리 없이 보거나 화면 없이 들을 때 무엇을 놓치나.
// 자막(말 · 말과 소리) · 음성 해설 · 대본을 켜고 끄며 놓친 정보를 센다(WCAG 1.2.1 · 1.2.2 · 1.2.3 · 1.2.5, Understanding).
// kind: see = 화면에만 나오는 것, say = 말, sound = 말이 아닌 소리
const scenes = [
  { t: '0:00', items: [{ kind: 'see', text: '화면 글자 「3단 우산 접기」' }] },
  { t: '0:04', items: [{ kind: 'say', text: '[진행자] 먼저 우산을 닫아 주세요.' }, { kind: 'see', text: '손잡이의 버튼을 누르는 손' }] },
  { t: '0:11', items: [{ kind: 'see', text: '살을 한 칸씩 모아 접는 손' }, { kind: 'sound', text: '(딸깍) — 다 접혀 잠겼다는 소리' }] },
  { t: '0:19', items: [{ kind: 'say', text: '[진행자] 끈으로 감으면 끝이에요.' }, { kind: 'see', text: '화면 글자 「끈은 두 바퀴」' }] },
];
---
<div class="lab mdlab" id="mdLab" data-scenes={JSON.stringify(scenes)}>
  <div class="md-fig">
    <ol class="md-time" id="mdTime" aria-label="영상에서 받는 것"></ol>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 같은 영상, 다른 방식</span>
    <h3>무엇을 놓치나</h3>
    <div class="chips" id="mdWay" role="group" aria-label="보는 방식">
      <button class="chip" type="button" data-v="both" aria-pressed="false">보고 들음</button>
      <button class="chip" type="button" data-v="mute" aria-pressed="true">소리 없이 봄</button>
      <button class="chip" type="button" data-v="blind" aria-pressed="false">화면 없이 들음</button>
    </div>
    <div class="chips" id="mdCap" role="group" aria-label="자막">
      <button class="chip" type="button" data-v="off" aria-pressed="true">자막 없음</button>
      <button class="chip" type="button" data-v="say" aria-pressed="false">자막: 말만</button>
      <button class="chip" type="button" data-v="all" aria-pressed="false">자막: 말과 소리</button>
    </div>
    <div class="chips" id="mdExtra" role="group" aria-label="음성 해설과 대본">
      <button class="chip" type="button" data-v="ad" aria-pressed="false">음성 해설</button>
      <button class="chip" type="button" data-v="tr" aria-pressed="false">대본</button>
    </div>
    <div class="readout" id="mdStat"></div>
    <p id="mdNote"></p>
    <div class="g-ui">
      <span class="label">UI에서</span>
      <p>대본은 영상 아래 바로 펼칠 수 있게, 자막과 해설은 재생 막대에서 켜고 끄게 둡니다. 진행자가 "이렇게"라고만 하지 않고 무엇을 하는지 말로 설명하면, 화면 없이 듣는 사람이 놓치는 것부터 줄어요.</p>
    </div>
  </div>
</div>

<script>
  type Item = { kind: 'see' | 'say' | 'sound'; text: string };
  const lab = document.querySelector<HTMLElement>('#mdLab')!;
  const scenes: { t: string; items: Item[] }[] = JSON.parse(lab.dataset.scenes!);
  let way = 'mute', cap = 'off', ad = false, tr = false;

  // 이 방식 · 설정에서 이 정보를 받는가, 받는다면 무엇으로
  function via(it: Item): string | null {
    if (tr) return '대본';
    if (it.kind === 'see') return way !== 'blind' ? '화면' : ad ? '음성 해설' : null;
    if (way !== 'mute') return '소리';
    if (cap === 'all') return '자막';
    if (cap === 'say' && it.kind === 'say') return '자막';
    return null;
  }
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const KIND = { see: '화면', say: '말', sound: '소리' };

  function draw() {
    const all = scenes.flatMap((s) => s.items);
    const lost = all.filter((it) => !via(it));
    lab.querySelector('#mdTime')!.innerHTML = scenes.map((s) => `<li><span class="mono">${s.t}</span><ul>${s.items.map((it) => {
      const v = via(it);
      return `<li class="${v ? '' : 'lost'}"><b class="mono">${KIND[it.kind]}</b><span>${v ? esc(it.text) : '— 놓침'}</span>${v ? `<em class="mono">${v}</em>` : ''}</li>`;
    }).join('')}</ul></li>`).join('');
    lab.querySelector('#mdStat')!.innerHTML = `${lost.length} / ${all.length}<small>놓친 정보</small>`;
    const kinds = [...new Set(lost.map((it) => KIND[it.kind]))].join(' · ');
    lab.querySelector('#mdNote')!.textContent = !lost.length
      ? tr ? '대본 하나로 화면 · 말 · 소리를 모두 받습니다. 영상 없이도 같은 내용이에요.' : '이 방식에서는 놓치는 것이 없습니다.'
      : way === 'mute'
        ? cap === 'say' ? `말은 자막으로 받지만 "(딸깍)"처럼 소리로만 알려 주는 것을 놓칩니다. 자막에는 뜻이 있는 소리도 넣어요.` : `소리 없이 보면 ${kinds} 정보를 놓칩니다. 자막이 그 자리를 채워요.`
        : `화면 없이 들으면 화면에만 나온 것을 놓칩니다. 화면 글자 「끈은 두 바퀴」처럼 말하지 않은 것이 특히 그래요. 음성 해설이나 대본이 채웁니다.`;
  }
  function group(id: string, multi: boolean, fn: (v: string, on: boolean) => void) {
    const g = lab.querySelector(id)!;
    g.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (multi) b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      else g.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      fn(b.dataset.v!, b.getAttribute('aria-pressed') === 'true');
      draw();
    });
  }
  group('#mdWay', false, (v) => { way = v; });
  group('#mdCap', false, (v) => { cap = v; });
  group('#mdExtra', true, (v, on) => { if (v === 'ad') ad = on; else tr = on; });
  draw();
</script>
