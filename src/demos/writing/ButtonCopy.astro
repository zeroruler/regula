---
// 같은 확인 다이얼로그의 버튼 문구를 확인/취소, 예/아니요, 동사로 바꿔 본다.
const cases = [
  { k: 'delete', n: '글 삭제', title: '이 글을 삭제할까요?', body: '삭제하면 되돌릴 수 없어요.', verbs: ['취소', '삭제'] },
  { k: 'leave', n: '저장 안 하고 나가기', title: '저장하지 않고 나갈까요?', body: '쓰던 내용은 사라져요.', verbs: ['계속 쓰기', '나가기'] },
  { k: 'cancel', n: '구독 해지', title: '구독을 해지할까요?', body: '이번 달 말까지는 계속 쓸 수 있어요.', verbs: ['구독 유지', '해지하기'] },
];
const styles = [
  { k: 'ok', n: '확인 · 취소', pair: ['취소', '확인'] },
  { k: 'yes', n: '예 · 아니요', pair: ['아니요', '예'] },
  { k: 'verb', n: '결과를 말하는 동사' },
];
---
<div class="lab wrlab" id="btnCopy" data-cases={JSON.stringify(cases)} data-styles={JSON.stringify(styles)}>
  <div class="wr-frame dim-bg">
    <div class="wr-dialog" role="presentation">
      <b id="bcTitle"></b>
      <span id="bcBody"></span>
      <div class="wr-acts"><span class="btn-x txt" id="bcNo"></span><span class="btn-x fill" id="bcYes"></span></div>
    </div>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 버튼 문구</span>
    <h3>버튼만 읽어도 알까</h3>
    <div class="chips" id="bcCases">
      {cases.map((c, i) => <button class="chip" type="button" data-k={c.k} aria-pressed={String(i === 1)}>{c.n}</button>)}
    </div>
    <div class="chips" id="bcStyles">
      {styles.map((s, i) => <button class="chip" type="button" data-k={s.k} aria-pressed={String(i === 1)}>{s.n}</button>)}
    </div>
    <p class="g-read">읽히는 것: <mark id="bcRead"></mark></p>
    <p>사람들은 다이얼로그 본문을 건너뛰고 버튼부터 읽습니다. "저장하지 않고 나갈까요?"에 "예/아니요"를 달면, 어느 쪽이 나가는 건지 질문을 다시 읽어야 해요.</p>
    <div class="g-ui">
      <span class="label">규칙</span>
      <p>버튼 = 누르면 일어나는 일(동사). 위험한 쪽은 "삭제"처럼 결과를, 안전한 쪽은 "계속 쓰기"처럼 머무는 행동을 적는다.</p>
    </div>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#btnCopy')!;
  const cases: { k: string; title: string; body: string; verbs: string[] }[] = JSON.parse(lab.dataset.cases!);
  const styles: { k: string; pair?: string[] }[] = JSON.parse(lab.dataset.styles!);
  let c = cases[1], s = styles[1];

  function render() {
    const pair = s.pair ?? c.verbs;
    lab.querySelector('#bcTitle')!.textContent = c.title;
    lab.querySelector('#bcBody')!.textContent = c.body;
    lab.querySelector('#bcNo')!.textContent = pair[0];
    lab.querySelector('#bcYes')!.textContent = pair[1];
    lab.querySelector('#bcRead')!.textContent =
      s.k === 'verb' ? '버튼만 읽어도 결과를 앎'
      : s.k === 'yes' && c.k !== 'delete' ? '질문을 다시 읽어야 함 — 무엇에 "예"인지'
      : '본문을 읽어야 무슨 일이 생길지 앎';
  }
  const pick = (sel: string, set: (k: string) => void) => lab.querySelector(sel)!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    set(b.dataset.k!);
    lab.querySelectorAll(`${sel} button`).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    render();
  });
  pick('#bcCases', (k) => (c = cases.find((x) => x.k === k)!));
  pick('#bcStyles', (k) => (s = styles.find((x) => x.k === k)!));
  render();
</script>
