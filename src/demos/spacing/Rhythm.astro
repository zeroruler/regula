---
// 수직 리듬: 본문 한 줄 높이(1lh)를 박자로 가로줄을 깔고, 문단 사이 여백과 제목 높이를 바꾼다.
// 여백이 1lh의 정수배가 아니면 그 아래 글줄이 모두 가로줄에서 벗어난다. 벗어난 글줄 왼쪽에 형광펜 표시.
const heads = [
  ['2', '제목 높이 2lh'],
  ['1.6', '제목 높이 1.6lh'],
] as const;
---
<div class="lab splab" id="spRhythm">
  <div class="sp-fig">
    <svg viewBox="0 0 320 270" role="img" aria-label="가로줄 위에 놓인 제목 하나와 문단 셋"><g class="sp-grid"></g><g class="sp-text"></g></svg>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 수직 리듬</span>
    <h3>여백 하나가 박자를 밀어낸다</h3>
    <div class="row">
      <label class="label" for="spGap">문단 사이</label>
      <input type="range" id="spGap" min="0.25" max="2" step="0.25" value="0.75" style="flex:1">
      <span class="mono" id="spGapVal"></span>
    </div>
    <div class="chips" id="spHead">
      {heads.map(([v, label], i) => <button class="chip" type="button" data-v={v} aria-pressed={String(i === 0)}>{label}</button>)}
    </div>
    <div class="readout" id="spOn" aria-live="polite"></div>
    <p id="spRNote"></p>
    <div class="g-ui">
      <span class="label">웹에서</span>
      <p>문단 사이를 <code>margin-block: 1lh</code>처럼 행간 단위로 잡으면 글자 크기나 행간을 바꿔도 박자가 따라갑니다. 제목은 행간이 달라 박자에서 벗어나기 쉬우니, 엄격히 맞추기보다 본문 문단 사이만 맞춰도 충분해요.</p>
    </div>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#spRhythm')!;
  const U = 14, TOP = 14, LEFT = 28, W = 270;
  const PARAS = [3, 2, 3];
  const gapIn = lab.querySelector<HTMLInputElement>('#spGap')!;
  let head = 2;

  const onGrid = (y: number) => Math.abs(((y - TOP) / U) - Math.round((y - TOP) / U)) < 0.01;

  function render() {
    const gap = +gapIn.value;
    let grid = '';
    for (let k = 0; k < 18; k++) {
      const by = TOP + k * U + U * 0.75;
      grid += `<line class="sp-base" x1="${LEFT - 8}" x2="${LEFT + W}" y1="${by}" y2="${by}" />`;
    }
    let y = TOP, out = '', on = 0, total = 0;
    // 제목: 굵은 막대 하나. 아래 여백은 1lh 고정
    const hb = y + head * U * 0.75 + (head - 1) * U * 0.25;
    out += `<rect class="sp-h" x="${LEFT}" y="${(hb - 9).toFixed(1)}" width="150" height="9" />`;
    y += head * U + U;
    PARAS.forEach((n, p) => {
      for (let i = 0; i < n; i++) {
        const by = y + U * 0.75, ok = onGrid(y);
        total++; if (ok) on++;
        const w = i === n - 1 ? W * (0.45 + 0.15 * p) : W;
        out += `<rect class="sp-l" x="${LEFT}" y="${(by - 4).toFixed(1)}" width="${w.toFixed(1)}" height="4" />`;
        if (!ok) out += `<rect class="sp-off" x="${LEFT - 18}" y="${(by - 8).toFixed(1)}" width="8" height="8" />`;
        y += U;
      }
      if (p < PARAS.length - 1) y += gap * U;
    });
    lab.querySelector('.sp-grid')!.innerHTML = grid;
    lab.querySelector('.sp-text')!.innerHTML = out;
    lab.querySelector('#spGapVal')!.textContent = `${gap}lh`;
    lab.querySelector('#spOn')!.innerHTML = `${on} / ${total}<small>가로줄 위에 놓인 본문 글줄</small>`;
    const whole = Number.isInteger(gap), headOk = Number.isInteger(head);
    lab.querySelector('#spRNote')!.textContent =
      whole && headOk ? '문단 사이와 제목 높이가 모두 1lh의 정수배라 모든 글줄이 같은 박자 위에 놓입니다.'
      : !headOk ? '제목 높이가 박자에서 벗어나 그 아래 글줄이 처음부터 전부 밀렸습니다. 문단 사이 여백으로 다시 맞추려면 어긋난 만큼을 보태야 해요.'
      : '문단 사이가 1lh의 정수배가 아니라, 첫 문단은 박자 위에 있지만 그 아래 글줄이 밀렸습니다. 어긋남은 아래로 쌓여서, 여백을 더한 값이 우연히 정수배가 되기 전까지 돌아오지 않아요.';
  }
  gapIn.addEventListener('input', render);
  const chips = lab.querySelector('#spHead')!;
  chips.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (!b) return;
    head = +b.dataset.v!;
    chips.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    render();
  });
  render();
</script>
