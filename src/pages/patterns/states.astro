---
import Base from '../../layouts/Base.astro';
import PatternSection from '../../components/PatternSection.astro';
import PatternSubnav from '../../components/PatternSubnav.astro';
import Wait from '../../demos/states/Wait.astro';
import Empty from '../../demos/states/Empty.astro';
import Indicators from '../../demos/states/Indicators.astro';
import { patternsByGroup } from '../../lib/patterns';
import { href } from '../../lib/url';
import Cite from '../../components/Cite.astro';
import { rulesOf, ruleId } from '../../lib/rules';

const groups = await patternsByGroup();
const loading = groups.find((x) => x.group.id === 'loading')!;
const empty = groups.find((x) => x.group.id === 'empty')!;

const { rules } = rulesOf('states');
---
<Base title="로딩과 빈 상태 · UI 패턴 · Regula" current="patterns" description="걸리는 시간에 맞는 로딩 표시를 고르고, 빈 화면에 설명과 다음 행동을 붙여 보는 실습 페이지">
  <Fragment slot="sub"><PatternSubnav current={['loading', 'empty']} /></Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('patterns/')}>§ 3 UI 패턴</a> · 실습</span>
    <h1>아무것도 없을 때도 말한다</h1>
    <p>화면이 기다리는 중이거나 보여 줄 것이 없을 때, 사람들은 고장 났는지부터 의심합니다. 기다림은 시간에 맞는 표시로, 빈 화면은 이유와 다음 행동으로 채웁니다.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 로딩</span>
      <h2>걸리는 시간이 표시를 고른다</h2>
      <p>시간을 정하고 표시를 골라 직접 불러와 보세요. 0.3초에 스피너를 띄우면 번쩍이고, 20초에 스피너만 돌리면 멈춘 것 같습니다.</p>
    </header>
    <Wait />
  </section>

  <section>
    <header>
      <span class="label">2 · 인디케이터 이름</span>
      <h2>막대처럼 생겨도 말하는 것이 다르다</h2>
      <p>로딩 막대처럼 보이는 것 9가지에도 각자 이름이 있습니다. 이름을 알면 회의나 AI 요청에서 정확히 짚을 수 있어요. 그리고 기다림을 말하는 것은 절반쯤이고, 나머지는 지금 위치 · 값 · 손짓을 말합니다. 무엇을 말하느냐에 따라 화면 낭독기에 알리는 방법(마크업)도 갈려요.</p>
    </header>
    <Indicators />
    <p style="margin-top:12px;font-family:var(--mono);font-size:11.5px;color:var(--ink-3);line-height:1.6">출처: <Cite text="Instagram @uxwoodytips 릴스(9가지 이름) · Apple HIG Progress indicators · Page controls · Apple UIKit prefersHomeIndicatorAutoHidden · Material Design 3 Progress indicators · Tabs · IBM Carbon Progress indicator · W3C WAI-ARIA 1.2 aria-current · W3C APG Carousel Pattern · Meter Pattern · OWASP Authentication Cheat Sheet · MDN env() · scroll() · WCAG 2.2 2.2.2 Pause, Stop, Hide · 1.4.1 Use of Color" />. 스토리 바 · 스크롤 진행 바는 릴스 밖에서 그 이름을 확인하지 못했습니다. 그림은 Regula가 다시 그린 흑백 도형입니다.</p>
  </section>

  <section>
    <header>
      <span class="label">3 · 빈 상태</span>
      <h2>왜 비었고, 이제 뭘 하나</h2>
      <p>같은 "없음"이라도 다 끝낸 것, 아직 시작 안 한 것, 찾는 게 없는 것, 불러오지 못한 것은 전혀 다른 말을 해야 합니다.</p>
    </header>
    <Empty />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r, i) => <tr id={ruleId('states', i)}><td>{r.s}</td><td>{r.rule}</td><td class="src-cell"><Cite text={r.src} /></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <PatternSection group={loading.group} items={loading.items} cols={[{ h: '알맞은 시간', k: 'fits' }]} />
  <PatternSection group={empty.group} items={empty.items} cols={[{ h: '언제', k: 'fits' }]} />
</Base>
