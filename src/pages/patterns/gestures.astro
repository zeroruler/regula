---
import Base from '../../layouts/Base.astro';
import PatternSection from '../../components/PatternSection.astro';
import PatternSubnav from '../../components/PatternSubnav.astro';
import RowActions from '../../demos/gestures/RowActions.astro';
import { patternsByGroup } from '../../lib/patterns';
import { href } from '../../lib/url';

const groups = await patternsByGroup();
const { group, items } = groups.find((x) => x.group.id === 'gestures')!;

// 제스처 규칙. 출처가 있는 것만 적는다.
const rules = [
  { s: '대체 수단', rule: '여러 손가락이나 경로를 그리는 제스처(핀치, 밀기)로 하는 일은 한 손가락으로 한 번 눌러서도 할 수 있어야 한다', src: 'WCAG 2.2 2.5.1 Pointer Gestures (A)' },
  { s: '끌기', rule: '끌어서 하는 일은 끌지 않고도(누르기만으로) 할 수 있어야 한다', src: 'WCAG 2.2 2.5.7 Dragging Movements (AA)' },
  { s: '취소', rule: '누를 때가 아니라 뗄 때 실행하고, 손가락을 밖으로 빼면 취소된다', src: 'WCAG 2.2 2.5.2 Pointer Cancellation (A)' },
  { s: '크기', rule: '누르는 목표는 최소 24px(AA), 권장은 44pt · 48dp', src: 'WCAG 2.2 2.5.8 Target Size (Minimum) · Apple HIG · Material Design 3' },
  { s: '숨김', rule: '보이지 않는 제스처는 지름길로만. 같은 일을 하는 보이는 컨트롤을 둔다', src: 'Apple HIG Gestures' },
  { s: '시스템', rule: '운영체제가 쓰는 제스처(가장자리 뒤로 가기, 홈 표시줄)와 겹치는 동작을 만들지 않는다', src: 'Apple HIG Gestures · Material Design 3 Gestures' },
];
---
<Base title="제스처 · UI 패턴 · Regula" current="patterns" description="탭부터 가장자리 스와이프까지 9가지 제스처를 알아채기 어려운 순으로 놓고, 숨은 동작과 대체 수단을 직접 써 보는 페이지">
  <Fragment slot="sub"><PatternSubnav current={['gestures']} /></Fragment>

  <header class="pagehead">
    <span class="label"><a href={href('patterns/')}>§ 3 UI 패턴</a> · 실습</span>
    <h1>숨은 동작은 지름길일 뿐</h1>
    <p>제스처는 아는 사람에게는 빠르고, 모르는 사람에게는 없는 기능입니다. 화면에 보이지 않으니 누군가는 끝내 찾지 못해요. 그래서 제스처마다 같은 일을 하는 보이는 길을 같이 적었습니다.</p>
  </header>

  <section>
    <header>
      <span class="label">1 · 대체 수단</span>
      <h2>같은 삭제, 세 가지 길</h2>
      <p>목록 항목을 밀어서, 길게 눌러서, ⋯ 버튼으로 지워 보세요. 그다음 ⋯ 버튼을 숨기면 어떤 사람이 막히는지 봅니다.</p>
    </header>
    <RowActions />
    <div class="compare">
      <table>
        <thead><tr><th>대상</th><th>규칙</th><th>출처</th></tr></thead>
        <tbody>
          {rules.map((r) => <tr><td>{r.s}</td><td>{r.rule}</td><td class="src-cell">{r.src}</td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <PatternSection group={group} items={items} cols={[{ h: '대체 수단', k: 'fits' }]} />
</Base>
