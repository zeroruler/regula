---
// 회원가입 양식 미리보기. ?system=<디자인 시스템>&state=<default|error|terms> 로 토큰과 상태를 바꾼다.
// 사이트 레이아웃 없이 단독 화면으로 열린다 (양식 상세 페이지의 iframe 안). 구조와 토큰 입히기는 로그인 미리보기와 같다.
import { loadThemes } from '../../lib/themes';

const themes = await loadThemes();
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>회원가입 미리보기 · Regula</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/complete/WantedSansVariable.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Noto+Serif+KR:wght@600&family=Archivo+Black&family=Black+Han+Sans&family=Gothic+A1:wght@400;700&family=Hahmlet:wght@700&family=IBM+Plex+Sans+KR:wght@400;600&display=swap">
<style>
:root{
  --stroke:1px; --button-shadow:none; --input-shadow:none; --card-shadow:none;
  --title-weight:700; --title-tracking:-0.02em;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:16px;line-height:1.6;display:grid;grid-template-columns:minmax(0,1fr);place-items:center;min-height:100vh;padding:32px 16px}
.embedded body{min-height:0}
.card{width:100%;max-width:420px;background:var(--surface);border:var(--stroke) solid var(--card-border);border-radius:var(--card-radius);box-shadow:var(--card-shadow);padding:36px 32px 28px;display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
h1{margin:0 0 4px;font-family:var(--display);font-weight:var(--title-weight);letter-spacing:var(--title-tracking);font-size:30px;line-height:1.15}
.summary{margin:0;padding:14px 16px;border:var(--stroke) solid var(--danger);border-radius:var(--radius);font-size:14px}
.summary:focus{outline:2px solid var(--key);outline-offset:2px}
.summary h2{margin:0 0 6px;font-size:15px;color:var(--danger)}
.summary ul{margin:0;padding-left:18px;display:grid;gap:2px}
.summary a{color:var(--danger)}
.field{display:grid;grid-template-columns:minmax(0,1fr);gap:6px}
label,.legend{font-size:14px;font-weight:600}
.hint{margin:-2px 0 0;font-size:13px;color:var(--ink2)}
.opt{font-weight:400;color:var(--ink3)}
.box{display:flex;align-items:center;background:var(--surface);border:var(--stroke) solid var(--border);border-radius:var(--radius);box-shadow:var(--input-shadow)}
.box:focus-within{outline:2px solid var(--key);outline-offset:2px}
input:not([type=checkbox]){flex:1;min-width:0;height:44px;border:0;background:transparent;padding:0 12px;font:inherit;color:var(--ink);outline:none}
.field.err .box{border-color:var(--danger)}
.msg{font-size:13px;color:var(--danger);margin:0}
.toggle{border:0;background:none;color:var(--ink2);font:inherit;font-size:13px;font-weight:600;padding:0 12px;height:44px;cursor:pointer}
fieldset{margin:0;padding:0;border:0;display:grid;gap:8px;min-width:0}
fieldset .legend{padding:0;margin-bottom:2px}
.terms{border:var(--stroke) solid var(--border);border-radius:var(--radius);overflow:hidden}
.terms.err{border-color:var(--danger)}
.check{display:flex;align-items:center;gap:10px;padding:10px 14px;font-size:14px;font-weight:400;cursor:pointer}
.check.all{font-weight:600;border-bottom:var(--stroke) solid var(--border)}
.check input{width:18px;height:18px;margin:0;flex:none;accent-color:var(--key)}
.check span{flex:1;min-width:0}
.check a{font-size:13px;color:var(--ink2);flex:none}
.tag{font-size:12px;color:var(--ink3);margin-left:4px}
.tag.req{color:var(--ink2);font-weight:600}
.primary{height:48px;border:var(--stroke) solid var(--key);border-radius:var(--radius);background:var(--key);color:var(--on-key);font:inherit;font-weight:600;font-size:15px;box-shadow:var(--button-shadow);cursor:pointer}
a{color:var(--ink2)}
.foot{margin:4px 0 0;text-align:center;font-size:14px;color:var(--ink2)}
.foot a{color:var(--ink);font-weight:600}
.done{margin:0;padding:12px 14px;border:var(--stroke) solid var(--border);border-radius:var(--radius);font-size:14px;color:var(--ink2)}
@media (max-width:400px){ .card{padding:28px 20px 24px} }
</style>
</head>
<body>
<form class="card" novalidate>
  <h1>계정 만들기</h1>
  <div class="summary" id="summary" role="alert" tabindex="-1" hidden>
    <h2>고칠 곳이 있어요</h2>
    <ul id="summaryList"></ul>
  </div>
  <div class="field" id="f-name">
    <label for="name">이름 <span class="opt">(선택)</span></label>
    <div class="box"><input id="name" type="text" autocomplete="name" spellcheck="false"></div>
  </div>
  <div class="field" id="f-email">
    <label for="email">이메일</label>
    <div class="box"><input id="email" type="email" autocomplete="email" spellcheck="false" autocapitalize="none" aria-describedby="m-email"></div>
    <p class="msg" id="m-email" hidden></p>
  </div>
  <div class="field" id="f-pw">
    <label for="pw">비밀번호 만들기</label>
    <p class="hint" id="h-pw">8자 이상. 글자 조합은 자유롭게, 흔한 비밀번호만 피해 주세요.</p>
    <div class="box">
      <input id="pw" type="password" autocomplete="new-password" spellcheck="false" autocapitalize="none" aria-describedby="h-pw m-pw">
      <button class="toggle" type="button" aria-controls="pw" aria-pressed="false">보기</button>
    </div>
    <p class="msg" id="m-pw" hidden></p>
  </div>
  <fieldset id="f-terms" aria-describedby="m-terms">
    <legend class="legend">약관 동의</legend>
    <div class="terms">
      <label class="check all"><input type="checkbox" id="all"><span>모두 동의하기 <span class="tag">(선택 항목 포함)</span></span></label>
      <label class="check"><input type="checkbox" data-req id="t-service"><span>서비스 이용약관 <span class="tag req">필수</span></span><a href="#">보기</a></label>
      <label class="check"><input type="checkbox" data-req id="t-privacy"><span>개인정보 수집 · 이용 <span class="tag req">필수</span></span><a href="#">보기</a></label>
      <label class="check"><input type="checkbox" id="t-marketing"><span>이벤트 · 혜택 소식 받기 <span class="tag">선택</span></span><a href="#">보기</a></label>
    </div>
    <p class="msg" id="m-terms" hidden></p>
  </fieldset>
  <button class="primary" type="submit">계정 만들기</button>
  <p class="done" id="done" role="status" hidden></p>
  <p class="foot">이미 계정이 있나요? <a href="#">로그인</a></p>
</form>

<script is:inline define:vars={{ themes }}>
  if (window.self !== window.top) document.documentElement.classList.add('embedded');
  const params = new URLSearchParams(location.search);
  const theme = themes.find((t) => t.id === params.get('system')) ?? themes[0];
  for (const [role, value] of Object.entries(theme.vars)) if (value) document.documentElement.style.setProperty(`--${role}`, value);

  const $ = (s) => document.querySelector(s);
  const $$ = (s) => [...document.querySelectorAll(s)];
  // 미리보기용 짧은 목록. 실제 서비스는 유출 비밀번호 목록과 대조한다 (NIST SP 800-63B-4 §3.1.1.2)
  const common = ['12345678', '123456789', '1234567890', 'password', 'password1', 'qwerty123', '11111111', 'iloveyou', 'abcd1234', 'qwertyuiop'];
  const errors = { email: '', pw: '', terms: '' };

  const setError = (id, text) => {
    errors[id] = text;
    const f = $(`#f-${id}`);
    const m = $(`#m-${id}`);
    m.hidden = !text;
    m.textContent = text;
    if (id === 'terms') { $('.terms').classList.toggle('err', !!text); $$('[data-req]').forEach((c) => c.setAttribute('aria-invalid', String(!!text && !c.checked))); }
    else { f.classList.toggle('err', !!text); $(`#${id}`).setAttribute('aria-invalid', String(!!text)); }
  };
  // 형식 검사는 버튼을 눌렀을 때만 (입력 중·칸을 벗어날 때는 하지 않는다)
  const validate = () => {
    const email = $('#email').value.trim(), pw = $('#pw').value;
    setError('email', !email ? '이메일을 입력해 주세요.' : !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email) ? '이메일 형식이 아닙니다. @ 뒤 도메인을 확인해 주세요.' : '');
    setError('pw', !pw ? '비밀번호를 만들어 주세요.'
      : pw.length < 8 ? `비밀번호를 8자 이상으로 만들어 주세요. 지금 ${pw.length}자예요.`
      : common.includes(pw.toLowerCase()) ? '자주 쓰여 쉽게 맞힐 수 있는 비밀번호예요. 다른 비밀번호를 만들어 주세요.' : '');
    // 계정 만들기는 필수 항목만 따진다. 선택 항목은 비워도 가입된다
    setError('terms', $$('[data-req]').every((c) => c.checked) ? '' : '필수 약관 2개에 동의해야 계정을 만들 수 있어요.');
    const list = [['email', '#email'], ['pw', '#pw'], ['terms', '#t-service']].filter(([k]) => errors[k]);
    $('#summaryList').replaceChildren(...list.map(([k, target]) => {
      const li = document.createElement('li'), a = document.createElement('a');
      a.href = target; a.textContent = errors[k];
      a.addEventListener('click', (e) => { e.preventDefault(); $(target).focus(); });
      li.append(a); return li;
    }));
    $('#summary').hidden = list.length === 0;
    return list.length === 0;
  };

  // 모두 동의 ↔ 항목. 항목이 다 체크되면 모두 동의도 체크, 하나라도 빠지면 해제
  const items = $$('.terms input:not(#all)');
  const syncAll = () => { const n = items.filter((c) => c.checked).length; $('#all').checked = n === items.length; $('#all').indeterminate = n > 0 && n < items.length; };
  $('#all').addEventListener('change', (e) => { items.forEach((c) => (c.checked = e.target.checked)); syncAll(); });
  items.forEach((c) => c.addEventListener('change', syncAll));

  $('form').addEventListener('submit', (e) => {
    e.preventDefault();
    $('#done').hidden = true;
    if (!validate()) { $('#summary').focus(); return; }
    const mk = $('#t-marketing').checked;
    $('#done').textContent = `미리보기라 실제 계정은 만들지 않아요. 필수 약관만으로 가입할 수 있고, 소식 받기는 ${mk ? '동의' : '동의하지 않음'}으로 저장됩니다.`;
    $('#done').hidden = false;
  });
  $('.toggle').addEventListener('click', (e) => {
    const pw = $('#pw'), show = pw.type === 'password';
    pw.type = show ? 'text' : 'password';
    e.currentTarget.textContent = show ? '숨기기' : '보기';
    e.currentTarget.setAttribute('aria-pressed', String(show));
  });

  const state = params.get('state');
  if (state === 'error') { $('#email').value = 'woody@mail'; $('#pw').value = 'regula'; validate(); }
  if (state === 'terms') {
    $('#name').value = '정이음'; $('#email').value = 'woody@mail.com'; $('#pw').value = 'paper-ruler-07';
    $$('[data-req]').forEach((c) => (c.checked = true)); syncAll();
  }
</script>
</body>
</html>
