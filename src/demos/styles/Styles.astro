---
// 같은 메모 카드를 9가지 스타일로 바꿔 본다. 흑백 원칙이라 색은 빼고 재료(그림자 · 테두리 · 투명도 · 질감)만 남겼다.
const styles = [
  { k: 'skeuo', n: '스큐어모피즘', p: 'skeuomorphic UI, realistic paper and leather textures, soft lighting, glossy button' },
  { k: 'flat', n: '플랫', p: 'flat design, solid colors, no shadows, simple geometric shapes' },
  { k: 'material', n: '머티리얼', p: 'Material Design 3, layered surfaces, elevation shadows, rounded containers' },
  { k: 'neu', n: '뉴모피즘', p: 'neumorphism, soft UI, same-color background, dual soft shadows (light top-left, dark bottom-right)' },
  { k: 'glass', n: '글래스모피즘', p: 'glassmorphism, frosted glass panel, background blur, thin light border, blurred shapes behind' },
  { k: 'clay', n: '클레이모피즘', p: 'claymorphism, soft 3D clay, inflated rounded shapes, inner shadows, pastel' },
  { k: 'brutal', n: '네오 브루탈리즘', p: 'neo-brutalism, thick black borders, hard offset shadows, flat bright colors, bold type' },
  { k: 'icon3d', n: '3D 아이콘', p: '3D icon, soft render, studio lighting, subtle gloss, front view' },
  { k: 'liquid', n: '리퀴드 글래스', p: 'Apple Liquid Glass, translucent refractive glass, specular highlights, adapts to content beneath' },
];
const warn: Record<string, string> = {
  neu: '버튼 경계가 그림자뿐 — 대비 3:1을 넘기 어렵다',
  glass: '뒤 배경에 따라 글자 대비가 바뀐다',
  liquid: '뒤 배경에 따라 글자 대비가 바뀐다',
  flat: '버튼이 그냥 색 상자로 보일 수 있다',
};
---
<div class="lab vslab" id="vsLab" data-styles={JSON.stringify(styles)} data-warn={JSON.stringify(warn)}>
  <div class="vs-stage" id="vsStage" data-s="material">
    <i class="vs-blob a"></i><i class="vs-blob b"></i><i class="vs-blob c"></i>
    <div class="vs-card" aria-hidden="true">
      <div class="vs-head"><span class="vs-ico"><i></i><i></i><i></i></span><b>오늘 할 일</b></div>
      <div class="vs-lines"><i></i><i></i><i class="w"></i></div>
      <span class="vs-btn">저장</span>
    </div>
  </div>
  <div class="lab-side">
    <span class="label">실험 · 같은 카드, 9가지 스타일</span>
    <h3>이름이 곧 재료</h3>
    <div class="chips" id="vsChips">
      {styles.map((s) => <button class="chip" type="button" data-k={s.k} aria-pressed={String(s.k === 'material')}>{s.n}</button>)}
    </div>
    <p class="g-read" aria-live="polite">재료: <mark id="vsRecipe"></mark></p>
    <p id="vsWarn" class="vs-warn"></p>
    <div class="vs-prompt">
      <span class="label">AI에게 넘길 말</span>
      <code id="vsPrompt"></code>
      <button type="button" class="chip" id="vsCopy">복사</button>
    </div>
    <div class="g-ui">
      <span class="label">흑백으로 본 이유</span>
      <p>Regula의 도해는 흑백이라 색은 뺐습니다. 대신 스타일을 가르는 것이 색보다 재료 — 그림자가 몇 겹인지, 테두리가 있는지, 뒤가 비치는지 — 라는 게 더 잘 보여요. 글래스 계열은 실제로는 뒤의 색이 비쳐 더 화려합니다.</p>
    </div>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('#vsLab')!;
  const styles: { k: string; n: string; p: string }[] = JSON.parse(lab.dataset.styles!);
  const warn: Record<string, string> = JSON.parse(lab.dataset.warn!);
  const recipes = Object.fromEntries([...document.querySelectorAll<HTMLElement>('.formulas .f')].map((f) => [f.id.replace('f-style-', ''), f.querySelector('.eq')?.textContent ?? '']));
  const ids: Record<string, string> = { skeuo: 'skeuomorphism', flat: 'flat', material: 'material', neu: 'neumorphism', glass: 'glassmorphism', clay: 'claymorphism', brutal: 'neobrutalism', icon3d: '3d-icon', liquid: 'liquid-glass' };
  const $ = (id: string) => lab.querySelector<HTMLElement>(`#${id}`)!;

  function set(k: string) {
    const s = styles.find((x) => x.k === k)!;
    $('vsStage').dataset.s = k;
    $('vsRecipe').textContent = recipes[ids[k]] || s.n;
    $('vsWarn').textContent = warn[k] ? `주의 · ${warn[k]}` : '';
    $('vsPrompt').textContent = s.p;
    $('vsCopy').textContent = '복사';
    lab.querySelectorAll('#vsChips button').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.k === k)));
  }
  $('vsChips').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('button');
    if (b) set(b.dataset.k!);
  });
  $('vsCopy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($('vsPrompt').textContent ?? ''); $('vsCopy').textContent = '복사함'; }
    catch { $('vsCopy').textContent = '직접 선택해 복사'; }
  });
  set('material');
</script>
