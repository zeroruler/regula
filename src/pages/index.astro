---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { nav, log, type SectionKey } from '../lib/site';
import { href } from '../lib/url';

// 홈은 입구만 둔다. 내용은 각 페이지에서 본다.
const [formulas, patterns, references, templates] = await Promise.all([
  getCollection('formulas'),
  getCollection('patterns'),
  getCollection('references'),
  getCollection('templates'),
]);
const counts: Record<SectionKey, string> = {
  principles: `공식 ${formulas.length} · 실험 ${formulas.filter((f) => f.data.demo).length}`,
  tools: '도구 3',
  patterns: `패턴 ${patterns.length} · 카테고리 ${new Set(patterns.map((p) => p.data.category)).size}`,
  references: `레퍼런스 ${references.length}`,
  templates: `양식 ${templates.length}`,
  log: `기록 ${log.length}`,
};
---
<Base title="Regula">
  <div class="hero">
    <span class="label">개인 디자인 규칙집</span>
    <h1><em>Regula</em></h1>
    <p>디자인을 공부하면서 찾은 공식, 화면 패턴, 페이지 양식을 한 곳에 쌓는 노트입니다. 감으로 고르던 값을 이유가 있는 값으로 바꾸는 게 목표예요.</p>
    <div class="etym"><span><b>regula</b> (라틴어)</span><span>① 자, 곧은 막대</span><span>② 규칙, 기준</span></div>
  </div>

  {nav.map((g) => (
    <section class="doors">
      <h2 class="label">{g.group}</h2>
      {g.items.map((s) => (
        <a class="door" href={href(s.path)}>
          <span class="no">§ {s.no}</span>
          <span class="t"><b>{s.title}</b><small>{s.blurb}</small></span>
          <span class="n">{counts[s.key]} →</span>
        </a>
      ))}
    </section>
  ))}

  <section class="doors">
    <h2 class="label">최근 기록</h2>
    <div class="log">
      {log.slice(0, 2).map((e) => <div class="e"><span>{e.date}</span><span>{e.text}</span></div>)}
    </div>
  </section>
</Base>
